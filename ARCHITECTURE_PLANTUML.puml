entity "TicketSite" as ticketsite {
    *id : INT
    --
    siteName : VARCHAR
    serviceName : VARCHAR
    typeTrans : VARCHAR
    status : VARCHAR
    --
    ticket_id : INT
}

entity "TicketComment" as comment {
    *id : INT
    --
    *content : TEXT
    *createdAt : DATETIME
    --
    ticket_id : INT
    user_id : INT
}

entity "TicketHistory" as history {
    *id : INT
    --
