ticket ||--o{ task : "has many"
ticket ||--o{ ticketsite : "has many"
ticket ||--o{ comment : "has many"
ticket ||--o{ history : "has many"
ticket }o--|| user : "created by"
task }o--|| user : "assigned to"
task }o--|| user : "next assigned to"
comment }o--|| user : "created by"
history }o--|| user : "created by"
notification }o--|| user : "for"
processed }o--|| site : "references"

@enduml

@startuml Workflow_State_Machine

title PFE 5G - IP Engineering Workflow State Machine

[*] --> engineering_ip : Create Ticket

state engineering_ip {
    [*] --> Analyzing
    Analyzing --> Decision : Complete Analysis
}

state "Decision Point" as decision <<choice>>
engineering_ip --> decision

decision --> execution_site : OK
decision --> capillaire_fo : besoin_fo
decision --> engineering_ip : swap_routeur

state capillaire_fo {
    [*] --> Studying
    Studying --> Complete : Study Complete
}

capillaire_fo --> deploiement_fo

state deploiement_fo {
    [*] --> Planning
    Planning --> Complete : Deployment Complete
}

deploiement_fo --> validation_fo

state validation_fo {
    [*] --> Validating
    Validating --> Complete : Validation Complete
}

validation_fo --> execution_site

state execution_site {
    [*] --> Executing
    Executing --> Complete : Execution Complete
}

execution_site --> validation_finale

state validation_finale {
    [*] --> FinalValidating
    FinalValidating --> Decision : Validation Complete
}

state "Final Decision" as final_decision <<choice>>
validation_finale --> final_decision

final_decision --> [*] : OK (Completed)
final_decision --> execution_site : NOK (Correction)

note right of decision
  Decision Options:
  - OK: Proceed to deployment
  - besoin_fo: Need fiber optic
  - swap_routeur: Router swap needed
end note

note right of final_decision
  Final Validation:
  - OK: Workflow completed
  - NOK: Return to execution
end note

@enduml

@startuml FH_Workflow

title PFE 5G - FH (Faisceau Hertzien) Workflow

[*] --> STEP_FH_ETUDE_PREREQUIS : Create FH Ticket

state STEP_FH_ETUDE_PREREQUIS {
    [*] --> StudyingPrerequis
    StudyingPrerequis --> Complete : Study Complete
}

state "FH Decision" as fh_decision <<choice>>
STEP_FH_ETUDE_PREREQUIS --> fh_decision

fh_decision --> STEP_FH_ETUDE_CAPACITE : OK
fh_decision --> STEP_FH_BESIN_FO : besoin_fo
fh_decision --> STEP_FH_SWAP_ROUTEUR : swap_routeur

state STEP_FH_ETUDE_CAPACITE {
    [*] --> StudyingCapacity
    StudyingCapacity --> Complete : Capacity Study Complete
}

STEP_FH_ETUDE_CAPACITE --> STEP_FH_DEPLOIEMENT

state STEP_FH_BESIN_FO {
    [*] --> StudyingFONeed
    StudyingFONeed --> Complete : FO Need Study Complete
}

STEP_FH_BESIN_FO --> STEP_FH_DEPLOIEMENT_FO

state STEP_FH_DEPLOIEMENT_FO {
    [*] --> DeployingFO
    DeployingFO --> Complete : FO Deployment Complete
}

STEP_FH_DEPLOIEMENT_FO --> STEP_FH_DEPLOIEMENT

state STEP_FH_SWAP_ROUTEUR {
    [*] --> SwappingRouter
    SwappingRouter --> Complete : Router Swap Complete
}

STEP_FH_SWAP_ROUTEUR --> STEP_FH_ETUDE_PREREQUIS

state STEP_FH_DEPLOIEMENT {
    [*] --> Deploying
    Deploying --> Complete : Deployment Complete
}

STEP_FH_DEPLOIEMENT --> STEP_FH_VALIDATION

state STEP_FH_VALIDATION {
    [*] --> Validating
    Validating --> Complete : Validation Complete
}

state "FH Final Decision" as fh_final <<choice>>
STEP_FH_VALIDATION --> fh_final

fh_final --> [*] : OK (Completed)
fh_final --> STEP_FH_DEPLOIEMENT : NOK (Correction)

@enduml

@startuml Data_Flow_Site_Analysis

title PFE 5G - Site Analysis Data Flow

actor "User" as user
participant "DataImportController" as import
participant "PythonApiClient" as client
participant "FastAPI\n/traiter" as api
participant "traitement.py" as traitement
database "PostgreSQL" as db
participant "AdminDashboardController" as admin

user -> import : Upload Excel Files\n(traffic, port, link, GPS)
activate import

import -> client : Send files for processing
activate client

client -> api : POST /traiter\n(multipart form-data)
activate api

api -> traitement : Process files
activate traitement

traitement -> traitement : Classify sites\n(TF/TDD/FDD)
traitement -> traitement : Calculate capacity\nutilization
traitement -> traitement : Detect congestion\n(>90% threshold)
traitement -> traitement : Integrate GPS\ncoordinates
traitement -> traitement : Historical data\ntracking

traitement -> db : Store processed_site\nanalyse_resultat
activate db
db --> traitement : Success
deactivate db

traitement --> api : Return results
deactivate traitement

api --> client : JSON response
deactivate api

client --> import : Results
deactivate client

import -> user : Display success
deactivate import

user -> admin : View dashboard
activate admin

admin -> db : Query statistics
activate db
db --> admin : Data
deactivate db

admin --> user : Display statistics\n(Total sites, critical,\nservice distribution)
deactivate admin

@enduml

@startuml Data_Flow_Ticket_Creation

title PFE 5G - Ticket Creation Workflow

actor "User" as user
participant "UserIpController" as ipctrl
participant "WorkflowEngineService" as workflow
participant "TicketTask" as task
participant "User Repository" as userrepo
participant "NotificationService" as notif
participant "Assigned User" as assignee

user -> ipctrl : Create ticket
activate ipctrl

ipctrl -> workflow : createInitialIpTask()
activate workflow

workflow -> workflow : Create Ticket entity
workflow -> workflow : Create initial task\n(engineering_ip or\nSTEP_FH_ETUDE_PREREQUIS)

workflow -> userrepo : Find user by\ndepartment/service
activate userrepo
userrepo --> workflow : User found
deactivate userrepo

workflow -> task : Assign to user
workflow -> task : Set status PENDING
workflow -> task : Set stepCode

workflow -> db : Persist ticket and task
activate db
db --> workflow : Success
deactivate db

workflow -> notif : notify(assignedUser)
activate notif
notif -> assignee : Task assignment\nnotification
deactivate notif

workflow --> ipctrl : Task created
deactivate workflow

ipctrl --> user : Ticket created\nwith initial task
deactivate ipctrl

assignee -> user : View notification
activate assignee
assignee --> user : Accept task
deactivate assignee

@enduml

@startuml Deployment_Architecture

title PFE 5G - Deployment Architecture

node "Docker Host" as docker {
    component "PostgreSQL 16\nPort 5432" as pg
    component "Symfony App\nPHP 8.2+FPM" as symfony
    component "FastAPI\nPython 3.x\nPort 8001" as fastapi
    volume "database_data" as volume
}

database "External SMTP\nPort 1025" as smtp

symfony --> pg : DATABASE_URL
symfony --> fastapi : PYTHON_API_BASE_URL
symfony --> smtp : MAILER_DSN
fastapi --> pg : DB_CONFIG
pg --> volume : Persist data

note right of docker
  Environment:
  - .env (base config)
  - .env.local (local overrides)
  - .env.dev (development)
  - .env.test (testing)
end note

note left of symfony
  Ports:
  - HTTP: 80/443
  - HTTPS: 443
end note

note left of fastapi
  Endpoints:
  - POST /traiter
  - POST /capacite/*
  - GET /health
end note

@enduml

@startuml Security_Architecture

title PFE 5G - Security Architecture

package "Symfony Security" {
    component "SecurityBundle" as security
    component "Role-Based\nAccess Control" as rbac
    component "Password\nHasher" as hasher
    component "Email\nVerification" as verify
}

package "User Roles" {
    component "ROLE_ADMIN" as admin
    component "ROLE_SUPERUSER" as super
    component "ROLE_USER" as user
}

package "Access Control" {
    component "Admin Controllers" as admin_ctrl
    component "Superuser Controllers" as super_ctrl
    component "User Controllers" as user_ctrl
}

security --> rbac
security --> hasher
security --> verify

rbac --> admin
rbac --> super
rbac --> user

admin --> admin_ctrl : Full access
super --> super_ctrl : Validation & oversight
user --> user_ctrl : Service-specific

note right of admin
  Capabilities:
  - Full system access
  - User management
  - Workflow configuration
  - All exports
end note

note right of super
  Capabilities:
  - Site validation
  - Map visualization
  - KPI monitoring
  - Site updates
end note

note right of user
  Capabilities:
  - Service-specific tasks
  - IP engineering
  - FH workflow
  - FO deployment
  - Deployment tasks
end note

@enduml

