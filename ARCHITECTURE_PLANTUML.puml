}

entity "Ticket" as ticket {
    *id : INT
    --
    *title : VARCHAR
    description : TEXT
    *actionType : VARCHAR
    *status : VARCHAR
    *priority : VARCHAR
    *progress : INT
    *currentStep : INT
    *totalSteps : INT
    *createdAt : DATETIME
    *updatedAt : DATETIME
    *startedAt : DATETIME
    *validatedAt : DATETIME
    *closedAt : DATETIME
    *deadline : DATETIME
    *workflowType : VARCHAR
    *reference : VARCHAR
    --
    createdBy_id : INT
}

entity "TicketTask" as task {
    *id : INT
    --
    *title : VARCHAR
    description : TEXT
    *status : VARCHAR
    *stepCode : VARCHAR
    *stepOrder : INT
    decision : VARCHAR
    comment : TEXT
    proofFile : VARCHAR
    siteValidated : VARCHAR
    *createdAt : DATETIME
    *updatedAt : DATETIME
    *startedAt : DATETIME
    *completedAt : DATETIME
