@startuml PFE_5G_Architecture

!define AWSPUML https://raw.githubusercontent.com/tupadr3/plantuml-aws-icons/master/dist
!include AWSPUML/AWSCommon.puml
!include AWSPUML/Database/AmazonRDS.puml
!include AWSPUML/Compute/AmazonEC2.puml

' ============================================
' HIGH-LEVEL SYSTEM ARCHITECTURE
' ============================================

title PFE 5G - High-Level System Architecture

package "User Interface" {
    [Symfony + Twig\nTemplates] as UI
}

package "Symfony Application\n(PHP 8.2+)" {
    component "Controllers\n(34)" as Controllers
    component "Services\n(10)" as Services
    component "Entities\n(20)" as Entities
    component "Security\n(RBAC)" as Security
}

database "PostgreSQL\n(Port 5432)" as DB
component "FastAPI\nPython API\n(Port 8001)" as PythonAPI
component "File System\n(Imports/Exports)" as FS

UI --> Controllers : HTTP Requests
Controllers --> Services : Business Logic
Services --> Entities : Data Access
Services --> PythonAPI : HTTP Client
Services --> DB : Doctrine ORM
PythonAPI --> DB : Direct Access
Controllers --> FS : File I/O

note right of PythonAPI
  Traffic Analysis
  Capacity Processing
  Site Classification
end note

note right of DB
  Tickets
  Sites
  Users
  Analysis Results
end note

@enduml

