{% extends 'dashboard/base_dashboard.html.twig' %}

{% block title %}Ticket Transmission FH #{{ ticket.id }}{% endblock %}

{% block dashboard_content %}
<div class="container mx-auto p-4">
    <div class="mb-6">
        <a href="{{ path('user_transmission_tickets') }}" class="text-blue-600 hover:underline">← Retour aux tickets</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- Main Ticket Info -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg shadow-md p-6 mb-4">
                <h1 class="text-2xl font-bold mb-2">{{ ticket.title }}</h1>
                <p class="text-gray-700 mb-4">{{ ticket.description }}</p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <strong>Statut:</strong>
                        <span class="bg-indigo-100 text-indigo-800 px-3 py-1 rounded text-sm">
                            {{ ticket.status|replace({'_': ' '})|upper }}
                        </span>
                    </div>
                    <div>
                        <strong>Priorité:</strong> {{ ticket.priority|upper }}
                    </div>
                    <div>
                        <strong>Créé le:</strong> {{ ticket.createdAt|date('d/m/Y H:i') }}
                    </div>
                    <div>
                        <strong>Service utilisateur:</strong> {{ app.user.service|upper }}
                    </div>
                </div>

                {% set visibleSites = ticket.ticketSites|filter(ts => ts.typeTrans|upper == app.user.service|upper) %}
                <div class="bg-gray-50 p-4 rounded mb-4">
                    <h2 class="font-semibold mb-3">Sites à traiter</h2>
                    {% if visibleSites is empty %}
                        <div class="rounded-lg border border-yellow-200 bg-yellow-50 p-4 text-yellow-800">
                            Aucun site correspondant au type de transport {{ app.user.service|upper }}.
                        </div>
                    {% else %}
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-100 text-left text-xs uppercase tracking-wider text-gray-500">
                                    <tr>
                                        <th class="px-4 py-3">Site</th>
                                        <th class="px-4 py-3">Type de transport</th>
                                        <th class="px-4 py-3">Service</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">
                                    {% for site in visibleSites %}
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-4 py-3 text-sm text-gray-700">{{ site.siteName }}</td>
                                            <td class="px-4 py-3 text-sm text-gray-700">{{ site.typeTrans|default('N/A') }}</td>
                                            <td class="px-4 py-3 text-sm text-gray-700">{{ site.serviceName|default('N/A') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>

                <div class="bg-gray-50 p-4 rounded mb-4">
                    <strong>Progrès:</strong>
                    <div class="mt-3 w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                        <div class="bg-green-500 h-2 rounded-full" style="width: {{ ticket.progress }}%"></div>
                    </div>
                    <p class="text-sm text-gray-600 mt-2">{{ ticket.progress }}%</p>
                </div>
            </div>

            {% if ticket.tasks %}
                <div class="bg-white rounded-lg shadow-md p-6 mb-4">
                    <h2 class="text-xl font-bold mb-4">Tâches FH (Etude, MLO, WO)</h2>
                    <div class="space-y-3">
                        {% for task in ticket.tasks %}
                            <div class="border-l-4 border-indigo-500 pl-4 py-2">
                                <div class="flex justify-between items-center">
                                    <span class="font-semibold">{{ task.stepCode }}</span>
                                    <span class="text-xs {% if task.status == 'done' %}text-green-600{% elseif task.status == 'in_progress' %}text-yellow-600{% else %}text-gray-600{% endif %}">
                                        {{ task.status|replace({'_': ' '})|upper }}
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mt-1">{{ task.description }}</p>
                                {% if task.requiresCapture and task.capturePath %}
                                    <div class="mt-2 text-sm">
                                        <a href="{{ asset('uploads/ticket_proofs/' ~ task.capturePath) }}" target="_blank" class="text-blue-600 hover:underline">
                                            📎 Capture jointe
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <div class="bg-white rounded-lg shadow-md p-6 mb-4">
                <h2 class="text-lg font-bold mb-4">Demander un Sous-Workflow</h2>
                <form method="POST" action="{{ path('user_transmission_subworkflow', {id: ticket.id}) }}">
                    <div class="mb-4">
                        <label for="subworkflow_service" class="block text-sm font-semibold mb-2">Service:</label>
                        {{ form_widget(subworkflowForm.service, {id: 'subworkflow_service'}) }}
                    </div>
                    <div class="mb-4">
                        <label for="subworkflow_reason" class="block text-sm font-semibold mb-2">Raison:</label>
                        {{ form_widget(subworkflowForm.reason, {id: 'subworkflow_reason'}) }}
                    </div>
                    <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700">
                        Créer Sous-Workflow
                    </button>
                </form>
            </div>
        </div>

        <!-- Sidebar -->
        <div>
            <!-- Ticket Info -->
            <div class="bg-gray-50 rounded-lg p-4">
                <h3 class="font-bold mb-3">Informations</h3>
                <div class="text-sm space-y-2">
                    <p><strong>Service:</strong> TRANSMISSION (FH)</p>
                    <p><strong>Type:</strong> {{ ticket.actionType }}</p>
                    <p><strong>Type Workflow:</strong> {{ ticket.workflowType }}</p>
                    <p><strong>Créé par:</strong> {{ ticket.createdBy.username }}</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
