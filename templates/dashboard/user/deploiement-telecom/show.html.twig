{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<div class="container mx-auto p-6">
    <h1 class="text-2xl font-bold mb-4">{{ task.title }}</h1>
    <p><strong>Ticket :</strong> {{ task.ticket.title }}</p>
    <p><strong>Description :</strong> {{ task.description|default('-') }}</p>

    <form method="post" action="{{ path('user_task_complete', {id: task.id}) }}">
        <div class="overflow-x-auto mt-6">
            <table class="min-w-full bg-white border">
                <thead>
                    <tr class="bg-gray-100">
                        <th class="px-4 py-2 border">Site</th>
                        <th class="px-4 py-2 border">Type</th>
                        <th class="px-4 py-2 border">Action requise</th>
                        <th class="px-4 py-2 border">Planification (date)</th>
                        <th class="px-4 py-2 border">Description de l'action</th>
                        <th class="px-4 py-2 border">Coordination des ressources</th>
                        <th class="px-4 py-2 border">Statut</th>
                        <th class="px-4 py-2 border">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ts in task.ticket.ticketSites %}
                        {% set siteData = task.siteData[ts.id] ?? null %}
                        <tr class="site-row" data-site-id="{{ ts.id }}">
                            <td class="px-4 py-2 border">{{ ts.siteName }} ({{ ts.typeTrans }})</td>
                            <td class="px-4 py-2 border">{{ ts.typeTrans }}</td>
                            <td class="px-4 py-2 border">
                                {% if task.stepCode == 'deploiement_fo' %}
                                    Action finale (WO IP)
                                {% elseif task.stepCode == 'deploiement_2eme_paire' %}
                                    Raccordement 2ème paire FO
                                {% else %}
                                    {{ task.title }}
                                {% endif %}
                            </td>
                            <td class="px-4 py-2 border">
                                <input type="date" name="planification[{{ ts.id }}]" class="border rounded p-1 w-full" value="{{ siteData.planification ?? '' }}">
                            </td>
                            <td class="px-4 py-2 border">
                                <textarea name="description[{{ ts.id }}]" rows="2" class="border rounded p-1 w-full">{{ siteData.description ?? '' }}</textarea>
                            </td>
                            <td class="px-4 py-2 border">
                                <div>
                                    <label><input type="checkbox" name="radio_ok[{{ ts.id }}]" value="1" {% if siteData.radio_ok %}checked{% endif %}> Support Radio OK</label>
                                </div>
                                <div>
                                    <label><input type="checkbox" name="backhaul_ok[{{ ts.id }}]" value="1" {% if siteData.backhaul_ok %}checked{% endif %}> Support Backhaul OK</label>
                                </div>
                                <div>
                                    <label><input type="checkbox" name="terrain_ok[{{ ts.id }}]" value="1" {% if siteData.terrain_ok %}checked{% endif %}> Accès terrain validé</label>
                                </div>
                            </td>
                            <td class="px-4 py-2 border">
                                {% if siteData.statut %}
                                    <span class="badge {{ siteData.statut == 'fait' ? 'green' : 'orange' }}">
                                        {{ siteData.statut == 'fait' ? 'Action réalisée' : 'En attente' }}
                                    </span>
                                {% else %}
                                    <span class="badge orange">Non démarré</span>
                                {% endif %}
                            </td>
                            <td class="px-4 py-2 border text-center">
                                <button type="button" class="save-site-btn bg-blue-600 text-white px-2 py-1 rounded text-sm" data-site-id="{{ ts.id }}">Enregistrer</button>
                                <button type="button" class="submit-site-btn bg-green-600 text-white px-2 py-1 rounded text-sm mt-1" data-site-id="{{ ts.id }}">Action réalisée</button>
                            </td>
                         </tr>
                    {% endfor %}
                </tbody>
             </table>
        </div>

        <div class="mt-6 text-center">
            <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded" id="submitAll" disabled>Valider toutes les actions</button>
            <a href="{{ path('user_tasks_dashboard') }}" class="ml-2 bg-gray-500 text-white px-6 py-2 rounded">Retour</a>
        </div>
    </form>
</div>

<script>
    // Sauvegarde individuelle des données du site (AJAX)
    async function saveSiteData(siteId, formData) {
        const response = await fetch(`{{ path('user_deploiement_site_data', {taskId: task.id, siteId: '__SITE_ID__'}) }}`.replace('__SITE_ID__', siteId), {
            method: 'POST',
            body: formData
        });
        return response.ok;
    }

    document.querySelectorAll('.save-site-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const row = btn.closest('.site-row');
            const siteId = row.dataset.siteId;
            const formData = new FormData();
            formData.append('planification', row.querySelector('input[name^="planification"]').value);
            formData.append('description', row.querySelector('textarea[name^="description"]').value);
            formData.append('radio_ok', row.querySelector('input[name^="radio_ok"]').checked ? '1' : '0');
            formData.append('backhaul_ok', row.querySelector('input[name^="backhaul_ok"]').checked ? '1' : '0');
            formData.append('terrain_ok', row.querySelector('input[name^="terrain_ok"]').checked ? '1' : '0');
            const ok = await saveSiteData(siteId, formData);
            if (ok) {
                btn.textContent = '✅ Enregistré';
                setTimeout(() => btn.textContent = 'Enregistrer', 2000);
            } else {
                alert('Erreur lors de l\'enregistrement.');
            }
        });
    });

    // Soumission individuelle pour marquer l'action comme réalisée
    document.querySelectorAll('.submit-site-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            if (!confirm('Confirmez-vous que l\'action pour ce site est entièrement réalisée ?')) return;
            const row = btn.closest('.site-row');
            const siteId = row.dataset.siteId;
            const formData = new FormData();
            formData.append('action_realisee', '1');
            const ok = await saveSiteData(siteId, formData);
            if (ok) {
                btn.textContent = '✅ Terminé';
                btn.disabled = true;
                // Recharger la page pour mettre à jour le statut
                location.reload();
            } else {
                alert('Erreur lors de la validation.');
            }
        });
    });

    // Vérifier si tous les sites ont l'action réalisée pour activer le bouton global
    function updateGlobalButton() {
        const allDone = Array.from(document.querySelectorAll('.submit-site-btn')).every(btn => btn.disabled === true);
        document.getElementById('submitAll').disabled = !allDone;
    }
    updateGlobalButton();
</script>

<style>
    .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .badge.green { background: #f0fdf4; color: #15803d; }
    .badge.orange { background: #fff7ed; color: #c2410c; }
</style>
{% endblock %}