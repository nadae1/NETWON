{% extends 'dashboard/base_dashboard.html.twig' %}

{% block title %}Tickets Radio{% endblock %}

{% block dashboard_content %}
<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6">Tickets Radio</h1>

    {% if tickets is empty %}
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded">
            Aucun ticket assigné à votre service.
        </div>
    {% else %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for ticket in tickets %}
                <a href="{{ path('user_radio_ticket_show', {id: ticket.id}) }}" 
                   class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-lg transition">
                    <h2 class="text-xl font-semibold text-gray-800 mb-2">{{ ticket.title }}</h2>
                    <p class="text-gray-600 text-sm mb-2">{{ ticket.description[:100] }}...</p>
                    
                    <div class="flex justify-between items-center mb-3">
                        <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded">
                            {{ ticket.status|replace({'_': ' '})|upper }}
                        </span>
                        <span class="text-xs text-gray-500">{{ ticket.createdAt|date('d/m/Y H:i') }}</span>
                    </div>

                    {% if ticket.tasks %}
                        <div class="text-xs text-gray-700">
                            <strong>Tâches:</strong> {{ ticket.tasks|length }} - 
                            {% set completed = ticket.tasks|filter(t => t.status == 'done')|length %}
                            Complétées: {{ completed }}/{{ ticket.tasks|length }}
                        </div>
                    {% endif %}
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
