{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<div class="container mx-auto p-6">
    <h1 class="text-2xl font-bold mb-4">Mes tâches</h1>
    <p class="mb-4 text-gray-600">Service : {{ user.service }}</p>

    {% if tasks is empty %}
        <div class="bg-yellow-100 border-l-4 border-yellow-500 p-4 rounded">
            ✅ Aucune tâche pour le moment.
        </div>
    {% else %}
        <div class="overflow-x-auto">
            <table class="min-w-full bg-white border">
                <thead class="bg-gray-100">
                    <tr>
                        <th>Tâche</th>
                        <th>Ticket</th>
                        <th>Sites concernés</th>
                        <th>Description</th>
                        <th>Date création</th>
                        <th>Statut</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for task in tasks %}
                        <tr class="border-b hover:bg-gray-50">
                            <td><strong>{{ task.title }}</strong></td>
                            <td>{{ task.ticket.title }}</td>
                            <td>
                                {% for ts in task.ticket.ticketSites %}
                                    {{ ts.siteName }} ({{ ts.typeTrans }}){% if not loop.last %}, {% endif %}
                                {% endfor %}
                            </td>
                            <td>{{ task.description|default('-')|slice(0, 80) }}{% if task.description|length > 80 %}...{% endif %}</td>
                            <td>{{ task.createdAt ? task.createdAt|date('d/m/Y H:i') : '-' }}</td>
                            <td>
                                {% if task.status == 'completed' %}
                                    <span class="badge green">Terminée</span>
                                {% elseif task.status == 'pending' %}
                                    <span class="badge orange">En attente</span>
                                {% elseif task.status == 'in_progress' %}
                                    <span class="badge blue">En cours</span>
                                {% else %}
                                    <span class="badge gray">{{ task.status }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('user_task_show', {id: task.id}) }}" class="bg-blue-600 text-white px-3 py-1 rounded text-sm">
                                    {% if task.status == 'completed' %}
                                        Voir détails
                                    {% else %}
                                        Démarrer
                                    {% endif %}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<style>
    .badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
    .badge.green { background: #dcfce7; color: #16a34a; }
    .badge.orange { background: #fef3c7; color: #d97706; }
    .badge.blue { background: #dbeafe; color: #2563eb; }
    .badge.gray { background: #f1f5f9; color: #475569; }
</style>
{% endblock %}