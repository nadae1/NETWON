{# templates/dashboard/user/tasks/show.html.twig #}
{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<div class="container mx-auto p-6">
    <div class="bg-white rounded-lg shadow p-6">
        <h1 class="text-2xl font-bold mb-4">{{ task.title }}</h1>
        <p><strong>Ticket :</strong> {{ task.ticket.title }}</p>
        <p><strong>Description :</strong> {{ task.description|default('-') }}</p>

        <form method="post" action="{{ path('user_task_complete', {id: task.id}) }}" id="decisionForm">
            <div class="overflow-x-auto mt-6">
                <table class="min-w-full bg-white border">
                    <thead>
                        <tr class="bg-gray-100">
                            <th class="px-4 py-2 border">Site</th>
                            <th class="px-4 py-2 border">Type</th>
                            <th class="px-4 py-2 border">Décision</th>
                            <th class="px-4 py-2 border">WO IP (si OK)</th>
                            <th class="px-4 py-2 border">Commentaire</th>
                            <th class="px-4 py-2 border">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ts in task.ticket.ticketSites %}
                            {% set siteIndex = loop.index0 %}
                            {% set siteDecision = task.siteDecisions[ts.id] ?? null %}
                            <tr class="site-row" data-site-id="{{ ts.id }}">
                                <td class="px-4 py-2 border">{{ ts.siteName }} ({{ ts.typeTrans }})</td>
                                <td class="px-4 py-2 border">{{ ts.typeTrans }}</td>
                                <td class="px-4 py-2 border">
                                    <select name="decision[{{ ts.id }}]" class="decision-select" data-site-id="{{ ts.id }}">
                                        <option value="">-- Choisir --</option>
                                        <option value="OK" {% if siteDecision and siteDecision.decision == 'OK' %}selected{% endif %}>OK – Faisable</option>
                                        <option value="NOK_2EME_PAIRE" {% if siteDecision and siteDecision.decision == 'NOK_2EME_PAIRE' %}selected{% endif %}>NOK – Besoin 2ème paire FO</option>
                                        <option value="NOK_SWAP" {% if siteDecision and siteDecision.decision == 'NOK_SWAP' %}selected{% endif %}>NOK – Swap routeur</option>
                                    </select>
                                </td>
                                <td class="px-4 py-2 border">
                                    <div class="woip-field" style="display: {% if siteDecision and siteDecision.decision == 'OK' %}block{% else %}none{% endif %};">
                                        <input type="text" name="wo_ip[{{ ts.id }}]" class="border rounded p-1 w-full" placeholder="Réf. WO IP" value="{{ siteDecision.wo_ip_reference ?? '' }}">
                                    </div>
                                </td>
                                <td class="px-4 py-2 border">
                                    <textarea name="comment[{{ ts.id }}]" rows="2" class="border rounded p-1 w-full">{{ siteDecision.comment ?? '' }}</textarea>
                                </td>
                                <td class="px-4 py-2 border text-center">
                                    <button type="button" class="save-site-btn bg-blue-600 text-white px-2 py-1 rounded text-sm" data-site-id="{{ ts.id }}">Enregistrer</button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-6 text-center">
                <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded" id="submitAll">Valider toutes les décisions</button>
                <a href="{{ path('user_tasks_dashboard') }}" class="ml-2 bg-gray-500 text-white px-6 py-2 rounded">Retour</a>
            </div>
        </form>
    </div>
</div>

<script>
    document.querySelectorAll('.decision-select').forEach(select => {
        select.addEventListener('change', function() {
            const row = this.closest('.site-row');
            const woipDiv = row.querySelector('.woip-field');
            woipDiv.style.display = this.value === 'OK' ? 'block' : 'none';
        });
    });

    async function saveSiteDecision(siteId, decision, woIpRef, comment) {
        const formData = new FormData();
        formData.append('decision', decision);
        formData.append('wo_ip_reference', woIpRef);
        formData.append('comment', comment);
        const response = await fetch(`{{ path('user_task_site_decision', {taskId: task.id, siteId: '__SITE_ID__'}) }}`.replace('__SITE_ID__', siteId), {
            method: 'POST',
            body: formData
        });
        return response.ok;
    }

    document.querySelectorAll('.save-site-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const row = btn.closest('.site-row');
            const siteId = row.dataset.siteId;
            const decision = row.querySelector('.decision-select').value;
            const woIpRef = row.querySelector('input[name^="wo_ip"]').value;
            const comment = row.querySelector('textarea[name^="comment"]').value;
            if (!decision) {
                alert('Veuillez choisir une décision pour ce site.');
                return;
            }
            const ok = await saveSiteDecision(siteId, decision, woIpRef, comment);
            if (ok) {
                btn.textContent = '✅ Enregistré';
                setTimeout(() => btn.textContent = 'Enregistrer', 2000);
            } else {
                alert('Erreur lors de l\'enregistrement.');
            }
        });
    });
</script>
{% endblock %}