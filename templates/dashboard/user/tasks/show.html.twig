{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
.task-container {
    max-width: 1000px;
    margin: 0 auto;
}

.task-header-banner {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    padding: 30px;
    border-radius: 12px;
    margin-bottom: 30px;
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2);
}

.task-title-main {
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 10px 0;
}

.task-meta-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    margin-top: 20px;
}

.meta-badge {
    background: rgba(255, 255, 255, 0.2);
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
}

.meta-label {
    display: block;
    font-size: 12px;
    opacity: 0.9;
    margin-bottom: 4px;
}

.meta-value {
    font-weight: 600;
    font-size: 16px;
}

.info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 30px;
}

.info-section {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
}

.section-title {
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 15px;
    font-size: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.info-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #f1f5f9;
    font-size: 14px;
}

.info-row:last-child {
    border-bottom: none;
}

.info-label {
    color: #64748b;
    font-weight: 500;
}

.info-value {
    color: #0f172a;
    font-weight: 600;
}

.form-section {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 30px;
}

.form-step {
    margin-bottom: 25px;
    padding-bottom: 25px;
    border-bottom: 1px solid #e2e8f0;
}

.form-step:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
}

.step-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 15px;
}

.step-number {
    background: #10b981;
    color: white;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
}

.step-title {
    font-size: 16px;
    font-weight: 600;
    color: #0f172a;
    margin: 0;
}

.form-group {
    margin-bottom: 15px;
}

.form-label {
    display: block;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 8px;
    font-size: 14px;
}

.form-control,
select,
textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
}

.form-control:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
}

textarea {
    resize: vertical;
    min-height: 100px;
}

.radio-group {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;
    margin-top: 10px;
}

.radio-option {
    position: relative;
    padding: 12px;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
}

.radio-option input {
    margin-right: 8px;
    cursor: pointer;
}

.radio-option:hover {
    border-color: #10b981;
    background: #f0fdf4;
}

.radio-option input:checked ~ label {
    color: #10b981;
    font-weight: 600;
}

.button-group {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #e2e8f0;
}

.btn {
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;
}

.btn-success {
    background: #10b981;
    color: white;
}

.btn-success:hover {
    background: #059669;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
}

.btn-secondary {
    background: #94a3b8;
    color: white;
    text-decoration: none;
}

.btn-secondary:hover {
    background: #64748b;
}

.alert {
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    display: none;
}

.alert.show {
    display: block;
}

.alert-warning {
    background: #fef3c7;
    color: #92400e;
    border-left: 4px solid #f59e0b;
}

.field-hint {
    font-size: 12px;
    color: #64748b;
    margin-top: 4px;
}

.sites-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
}

.site-badge {
    background: #dbeafe;
    color: #0c4a6e;
    padding: 10px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
}

@media (max-width: 768px) {
    .info-grid {
        grid-template-columns: 1fr;
    }

    .task-meta-info {
        grid-template-columns: 1fr;
    }

    .button-group {
        flex-direction: column;
    }

    .btn {
        width: 100%;
    }

    .radio-group {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="task-container">
    <!-- En-tête de la tâche -->
    <div class="task-header-banner">
        <div class="task-title-main">{{ task.title }}</div>
        <div class="task-meta-info">
            <div class="meta-badge">
                <span class="meta-label">🎫 Ticket</span>
                <span class="meta-value">#{{ task.ticket.id }}</span>
            </div>
            <div class="meta-badge">
                <span class="meta-label">📋 Statut</span>
                <span class="meta-value">{{ task.status|upper|replace({'_': ' '}) }}</span>
            </div>
            <div class="meta-badge">
                <span class="meta-label">👤 Assigné à</span>
                <span class="meta-value">{{ task.assignedTo.fullName ?? task.assignedTo.email }}</span>
            </div>
        </div>
    </div>

    <!-- Informations contextuelles -->
    <div class="info-grid">
        <!-- Ticket info -->
        <div class="info-section">
            <div class="section-title">
                <span>🎯</span> Ticket
            </div>
            <div class="info-row">
                <span class="info-label">Titre</span>
                <span class="info-value">{{ task.ticket.title }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Description</span>
                <span class="info-value">{{ task.ticket.description|slice(0, 50) }}...</span>
            </div>
            <div class="info-row">
                <span class="info-label">Progression</span>
                <span class="info-value">{{ task.ticket.progress }}%</span>
            </div>
            <div class="info-row">
                <span class="info-label">Créé le</span>
                <span class="info-value">{{ task.ticket.createdAt|date('d/m/Y') }}</span>
            </div>
        </div>

        <!-- Sites info -->
        <div class="info-section">
            <div class="section-title">
                <span>📍</span> Sites
            </div>
            <div class="sites-list">
                {% for site in task.ticket.ticketSites %}
                    <div class="site-badge">
                        <div style="font-weight: 700;">{{ site.siteName }}</div>
                        <div style="font-size: 11px; opacity: 0.8;">{{ site.typeTrans ?: 'N/A' }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Description de la tâche -->
    {% if task.description %}
    <div class="info-section" style="margin-bottom: 30px;">
        <div class="section-title">
            <span>📄</span> Description de la tâche
        </div>
        <p style="color: #475569; line-height: 1.6; margin: 0;">{{ task.description }}</p>
    </div>
    {% endif %}

    <!-- Formulaire de validation -->
    <div class="form-section">
        <div class="section-title" style="color: #1e293b;">
            <span>✏️</span> Valider la tâche
        </div>

        <form method="post" action="{{ path('user_task_complete', {id: task.id}) }}">
            <!-- Étape 1 : Type de carte -->
            <div class="form-step">
                <div class="step-header">
                    <div class="step-number">1</div>
                    <h3 class="step-title">Vérification des cartes</h3>
                </div>
                <div class="form-group">
                    <label class="form-label" for="cardType">Type de carte (UMPT) :</label>
                    <select name="card_type" id="cardType" class="form-control">
                        <option value="">-- Sélectionner --</option>
                        <option value="UMPTb1">UMPTb1</option>
                        <option value="UMPTb2">UMPTb2</option>
                        <option value="UMPTe1">UMPTe1</option>
                        <option value="UMPTe2">UMPTe2</option>
                        <option value="UMPTga2">UMPTga2</option>
                    </select>
                    <div class="field-hint">Compatibilité GPS / 5G / SFP 10G selon le tableau.</div>
                </div>
            </div>

            <!-- Étape 2 : Capacité mesurée -->
            <div class="form-step">
                <div class="step-header">
                    <div class="step-number">2</div>
                    <h3 class="step-title">Capacité mesurée</h3>
                </div>
                <div class="form-group">
                    <label class="form-label" for="capacity">Capacité (Mbps) :</label>
                    <input type="number" name="capacity" id="capacity" step="0.01" class="form-control" placeholder="Ex: 10000.50">
                    <div class="field-hint">Saisissez la capacité mesurée en Mbps.</div>
                </div>
            </div>

            <!-- Étape 3 : Décision -->
            <div class="form-step">
                <div class="step-header">
                    <div class="step-number">3</div>
                    <h3 class="step-title">Décision</h3>
                </div>
                <div class="form-group">
                    <label class="form-label">Veuillez choisir une option :</label>
                    <div class="radio-group">
                        <div class="radio-option">
                            <input type="radio" id="decision_ok" name="decision" value="OK">
                            <label for="decision_ok" style="cursor: pointer; display: inline;">✓ OK – Faisable</label>
                        </div>
                        <div class="radio-option">
                            <input type="radio" id="decision_fo" name="decision" value="NOK_2EME_PAIRE">
                            <label for="decision_fo" style="cursor: pointer; display: inline;">⚠️ NOK – 2ème paire FO</label>
                        </div>
                        <div class="radio-option">
                            <input type="radio" id="decision_swap" name="decision" value="NOK_SWAP">
                            <label for="decision_swap" style="cursor: pointer; display: inline;">🔄 NOK – Swap routeur</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Étape 4 : Work Order IP -->
            <div class="form-step" id="woIpFields" style="display: none;">
                <div class="step-header">
                    <div class="step-number">4</div>
                    <h3 class="step-title">Work Order IP</h3>
                </div>
                <div class="form-group">
                    <label class="form-label" for="woRef">Référence WO IP :</label>
                    <input type="text" name="wo_ip_reference" id="woRef" class="form-control" placeholder="Ex: WO-2024-001234">
                    <div class="field-hint">Saisissez la référence du Work Order IP généré.</div>
                </div>
            </div>

            <!-- Alerte si NOK -->
            <div class="alert alert-warning" id="infoNok">
                <strong>⚠️ Important :</strong> Un sous-workflow sera automatiquement créé et l'utilisateur suivant sera notifié pour traiter cette demande.
            </div>

            <!-- Commentaire -->
            <div class="form-step">
                <div class="step-header">
                    <div class="step-number">5</div>
                    <h3 class="step-title">Commentaire</h3>
                </div>
                <div class="form-group">
                    <label class="form-label" for="comment">Commentaire (optionnel)</label>
                    <textarea name="comment" id="comment" class="form-control" placeholder="Saisissez un commentaire si nécessaire..."></textarea>
                    <div class="field-hint">Fournissez des détails supplémentaires sur la décision ou les actions réalisées.</div>
                </div>
            </div>

            <!-- Boutons -->
            <div class="button-group">
                <a href="{{ path('user_tasks_dashboard') }}" class="btn btn-secondary">← Retour</a>
                <button type="submit" class="btn btn-success">✓ Valider et continuer</button>
            </div>
        </form>
    </div>
</div>

<script>
    const radios = document.querySelectorAll('input[name="decision"]');
    const woIpDiv = document.getElementById('woIpFields');
    const infoDiv = document.getElementById('infoNok');

    function updateFormState() {
        woIpDiv.style.display = 'none';
        infoDiv.classList.remove('show');
        
        const selected = document.querySelector('input[name="decision"]:checked');
        if (selected) {
            if (selected.value === 'OK') {
                woIpDiv.style.display = 'block';
            } else if (selected.value === 'NOK_2EME_PAIRE' || selected.value === 'NOK_SWAP') {
                infoDiv.classList.add('show');
            }
        }
    }

    radios.forEach(radio => {
        radio.addEventListener('change', updateFormState);
    });

    // Initialize form state on page load
    updateFormState();
</script>
{% endblock %}
