{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
    .support-dashboard { max-width: 1300px; margin: 0 auto; padding: 2rem; background: #fff; border-radius: 24px; box-shadow: 0 20px 60px rgba(0,0,0,.06); }
    .stats-row { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-bottom: 2rem; border-bottom: 1px solid #eef2f6; padding-bottom: 1rem; }
    .stat-item { display: flex; align-items: baseline; gap: .4rem; font-size: .95rem; color: #3e4c5e; }
    .stat-item .stat-value { font-size: 1.6rem; font-weight: 600; color: #0b1a33; }
    .stat-item .stat-label { color: #6b7a8e; }
    .toolbar { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.8rem; }
    .search-wrapper { flex: 1; min-width: 200px; position: relative; }
    .search-wrapper input { width: 100%; padding: .7rem 1rem .7rem 2.8rem; border: 1px solid #e2e8f0; border-radius: 40px; }
    .search-wrapper i { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #9aa8b9; }
    .filter-select select { padding: .7rem 1.2rem; border: 1px solid #e2e8f0; border-radius: 40px; background: #f8fafc; }
    .btn-filter { background: #2e75b6; color: #fff; border: none; padding: .6rem 1.4rem; border-radius: 40px; cursor: pointer; }
    .btn-reset { background: transparent; border: none; color: #2e75b6; cursor: pointer; }
    .table-wrapper { overflow-x: auto; border-radius: 16px; border: 1px solid #edf1f7; }
    table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    thead { background: #f8fafc; }
    th { text-align: left; padding: 1rem; font-size: .8rem; text-transform: uppercase; color: #5a6b7e; }
    td { padding: 1rem; border-bottom: 1px solid #f0f4f9; }
    .badge { display: inline-flex; align-items: center; gap: .3rem; padding: .25rem .9rem; border-radius: 40px; font-size: .75rem; font-weight: 500; }
    .badge-pending { background: #f0f4fa; color: #4a5c72; }
    .badge-in_progress { background: #e8f0fe; color: #1e5aa7; }
    .badge-done { background: #e3f5e8; color: #1a7a4a; }
    .badge-blocked { background: #fee9e7; color: #b34033; }
    .action-links a { margin-right: .5rem; color: #2e75b6; text-decoration: none; font-weight: 600; }
    .action-links a:hover { text-decoration: underline; }
</style>

<div class="support-dashboard">
    <h1 class="text-xl font-bold mb-4">📻 Support Radio — Mes tâches</h1>

    <div class="stats-row">
        <div class="stat-item"><span class="stat-value">{{ total|default(0) }}</span><span class="stat-label">Total</span></div>
        <div class="stat-item"><span class="stat-value">{{ pending|default(0) }}</span><span class="stat-label">En attente</span></div>
        <div class="stat-item"><span class="stat-value">{{ inProgress|default(0) }}</span><span class="stat-label">En cours</span></div>
        <div class="stat-item"><span class="stat-value">{{ done|default(0) }}</span><span class="stat-label">Terminées</span></div>
    </div>

    <form method="get" class="toolbar">
        <div class="search-wrapper">
            <i class="fas fa-search"></i>
            <input type="text" name="search" placeholder="Rechercher..." value="{{ searchQuery|default('') }}">
        </div>
        <div class="filter-select">
            <select name="status">
                <option value="">Tous statuts</option>
                <option value="pending" {% if currentStatus == 'pending' %}selected{% endif %}>En attente</option>
                <option value="in_progress" {% if currentStatus == 'in_progress' %}selected{% endif %}>En cours</option>
                <option value="blocked" {% if currentStatus == 'blocked' %}selected{% endif %}>Bloqué</option>
                <option value="done" {% if currentStatus == 'done' %}selected{% endif %}>Terminé</option>
            </select>
        </div>
        <button type="submit" class="btn-filter">Filtrer</button>
        {% if currentStatus or searchQuery %}<a href="{{ path('user_support_radio_index') }}" class="btn-reset">Réinitialiser</a>{% endif %}
    </form>

    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Tâche</th>
                    <th>Ticket</th>
                    <th>Service</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for task in tasks %}
                    {% set ticket = task.ticket %}
                    <tr>
                        <td><strong>{{ task.title }}</strong></td>
                        <td>#{{ ticket.id }} — {{ ticket.title }}</td>
                        <td>{{ ticket.service|default('N/A') }}</td>
                        <td>
                            {% if task.status == 'pending' %}
                                <span class="badge badge-pending">En attente</span>
                            {% elseif task.status == 'in_progress' %}
                                <span class="badge badge-in_progress">En cours</span>
                            {% elseif task.status == 'done' or task.status == 'completed' %}
                                <span class="badge badge-done">Terminée</span>
                            {% else %}
                                <span class="badge badge-blocked">Bloquée</span>
                            {% endif %}
                        </td>
                        <td class="action-links">
                            <a href="{{ path('user_support_radio_task_show', {id: task.id}) }}">Voir</a>
                            {% if task.status == 'pending' %}
                                <a href="{{ path('user_support_radio_task_show', {id: task.id}) }}?start=1">Démarrer</a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center py-4 text-gray-500">Aucune tâche.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}