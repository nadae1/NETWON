{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
.user-dashboard {
    padding-bottom: 40px;
}

.page-title {
    font-size: 28px;
    font-weight: 700;
    color: #07152f;
    margin: 0 0 8px 0;
}

.page-desc {
    color: #60708a;
    font-size: 16px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 30px;
}

.stat-card {
    border-radius: 16px;
    padding: 24px;
    min-height: 120px;
    display: flex;
    justify-content: space-between;
    gap: 14px;
}

.stat-blue {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
}

.stat-red {
    background: #fff1f2;
    border: 1px solid #fecaca;
}

.stat-green {
    background: #ecfeff;
    border: 1px solid #99f6e4;
}

.stat-orange {
    background: #fffbeb;
    border: 1px solid #fed7aa;
}

.stat-label {
    font-size: 13px;
    color: #64748b;
    font-weight: 600;
    letter-spacing: .5px;
    text-transform: uppercase;
}

.stat-value {
    font-size: 36px;
    font-weight: 800;
    color: #020617;
    line-height: 1.2;
    margin-top: 8px;
}

.stat-small {
    color: #536782;
    font-size: 13px;
    margin-top: 6px;
}

.stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
}

.icon-blue {
    background: #bfdbfe;
    color: #2563eb;
}

.icon-red {
    background: #fecaca;
    color: #ef4444;
}

.icon-green {
    background: #ccfbf1;
    color: #14b8a6;
}

.icon-orange {
    background: #fde68a;
    color: #d97706;
}

.service-badge {
    display: inline-block;
    background: #e2e8f0;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 20px;
}

.charts-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 28px;
    margin-top: 40px;
}

.chart-card {
    background: white;
    border: 1px solid #dbe3ef;
    border-radius: 18px;
    padding: 24px;
    min-height: 380px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.chart-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 24px;
    color: #020617;
}

.bar-chart {
    display: flex;
    align-items: flex-end;
    gap: 24px;
    height: 260px;
    border-left: 2px solid #94a3b8;
    border-bottom: 2px solid #94a3b8;
    padding-left: 16px;
    padding-bottom: 0;
    position: relative;
}

.bar-group {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 8px;
    position: relative;
}

.bar {
    width: 32px;
    border-radius: 6px 6px 0 0;
    min-height: 2px;
}

.bar-total {
    background: #3b82f6;
}

.bar-critical {
    background: #ef4444;
}

.bar-label {
    position: absolute;
    bottom: -32px;
    font-size: 13px;
    color: #526783;
    text-align: center;
    width: 100%;
}

.donut-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: 20px;
}

.donut {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    position: relative;
}

.donut::after {
    content: "";
    position: absolute;
    width: 100px;
    height: 100px;
    background: white;
    border-radius: 50%;
    top: 60px;
    left: 60px;
}

.legend {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 28px;
    flex-wrap: wrap;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #526783;
    font-size: 14px;
}

.legend-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
}

.sites-section {
    margin-top: 40px;
}

.table-like {
    background: white;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    overflow-x: auto;
}

.table-row {
    display: flex;
    align-items: center;
    padding: 14px 20px;
    border-bottom: 1px solid #e2e8f0;
    gap: 20px;
    flex-wrap: wrap;
}

.table-row:last-child {
    border-bottom: none;
}

.table-row > div {
    flex: 1;
    min-width: 120px;
}

.badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.badge.red {
    background: #fee2e2;
    color: #dc2626;
}

.badge.green {
    background: #dcfce7;
    color: #16a34a;
}

.view-all-link {
    margin-top: 16px;
    text-align: center;
}

.btn-outline {
    display: inline-block;
    padding: 10px 24px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    color: #3b82f6;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
}

.btn-outline:hover {
    background: #f8fafc;
    border-color: #3b82f6;
}
</style>

<div class="user-dashboard">
    <div>
        <h2 class="page-title">Dashboard - {{ serviceName }}</h2>
        <div class="page-desc">Vue filtrée par votre service: <strong>{{ serviceName }}</strong></div>
    </div>

    <div class="service-badge">
        🔧 Service actuel : {{ serviceName }}
    </div>

    <div class="stats-grid">
        <div class="stat-card stat-blue">
            <div>
                <div class="stat-label">Total Sites</div>
                <div class="stat-value">{{ totalSites }}</div>
                <div class="stat-small">{{ serviceName }} uniquement</div>
            </div>
            <div class="stat-icon icon-blue">📡</div>
        </div>

        <div class="stat-card stat-red">
            <div>
                <div class="stat-label">Sites Critiques</div>
                <div class="stat-value">{{ criticalSites }}</div>
                <div class="stat-small">{{ criticalPercentage }}% du total</div>
            </div>
            <div class="stat-icon icon-red">⚠️</div>
        </div>

        <div class="stat-card stat-green">
            <div>
                <div class="stat-label">Trafic Moyen</div>
                <div class="stat-value">{{ avgTraffic }}</div>
                <div class="stat-small">Mbps</div>
            </div>
            <div class="stat-icon icon-green">📊</div>
        </div>

        <div class="stat-card stat-orange">
            <div>
                <div class="stat-label">Type de Service</div>
                <div class="stat-value">{{ serviceName }}</div>
                <div class="stat-small">{{ classificationStats|length }} classifications</div>
            </div>
            <div class="stat-icon icon-orange">🏷️</div>
        </div>
    </div>

    <div class="charts-grid">
        <div class="chart-card">
            <div class="chart-title">Classification des sites ({{ serviceName }})</div>

            {% set maxValue = 1 %}
            {% for className, row in classificationStats %}
                {% if row.total > maxValue %}
                    {% set maxValue = row.total %}
                {% endif %}
            {% endfor %}

            <div class="bar-chart">
                {% for className, row in classificationStats %}
                    {% set totalHeight = (row.total / maxValue) * 100 %}
                    {% set criticalHeight = (row.critical / maxValue) * 100 %}

                    <div class="bar-group">
                        <div class="bar bar-total" style="height: {{ totalHeight }}%;" title="{{ className }} total: {{ row.total }}"></div>
                        <div class="bar bar-critical" style="height: {{ criticalHeight }}%;" title="{{ className }} critique: {{ row.critical }}"></div>
                        <div class="bar-label">{{ className }}</div>
                    </div>
                {% else %}
                    <div class="empty-state" style="width: 100%; text-align: center;">Aucune donnée</div>
                {% endfor %}
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-title">Résumé</div>
            <div class="donut-wrap">
                <div style="text-align: center;">
                    <div style="font-size: 48px; font-weight: 800; color: #3b82f6;">{{ totalSites }}</div>
                    <div style="color: #64748b;">Sites totaux</div>
                    <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #e2e8f0;">
                        <div style="font-size: 24px; font-weight: 700; color: #ef4444;">{{ criticalSites }}</div>
                        <div style="color: #64748b;">Sites critiques</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="sites-section">
        <div class="card">
            <h3 class="panel-title">Derniers sites traités</h3>

            {% if sites is empty %}
                <div class="empty-state">Aucune donnée importée pour votre service.</div>
            {% else %}
                <div class="table-like">
                    <div class="table-row" style="background: #f8fafc; font-weight: 600;">
                        <div>Site</div>
                        <div>Classification</div>
                        <div>Type Trans</div>
                        <div>Trafic Max</div>
                        <div>État</div>
                    </div>
                    {% for site in sites|slice(0, 5) %}
                        <div class="table-row">
                            <div><strong>{{ site.siteName }}</strong></div>
                            <div>{{ site.classification ?: '-' }}</div>
                            <div>{{ site.typeTrans ?: '-' }}</div>
                            <div>{{ site.maxTrafic|number_format(2, '.', ' ') }} Mbps</div>
                            <div>
                                {% if site.isCritical %}
                                    <span class="badge red">Critique</span>
                                {% else %}
                                    <span class="badge green">Normal</span>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <div class="view-all-link">
                    <a href="{{ path('user_dashboard_sites') }}" class="btn-outline">Voir tous les sites →</a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}