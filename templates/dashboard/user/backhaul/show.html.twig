{% extends 'dashboard/base_dashboard.html.twig' %}

{% block title %}Ticket Backhaul #{{ ticket.id }}{% endblock %}

{% block dashboard_content %}
<div class="container mx-auto p-4">
    <div class="mb-6">
        <a href="{{ path('user_backhaul_tickets') }}" class="text-blue-600 hover:underline">← Retour aux tickets</a>
    </div>

    <div class="grid grid-cols-3 gap-4">
        <!-- Main Ticket Info -->
        <div class="col-span-2">
            <div class="bg-white rounded-lg shadow-md p-6 mb-4">
                <h1 class="text-2xl font-bold mb-2">{{ ticket.title }}</h1>
                <p class="text-gray-700 mb-4">{{ ticket.description }}</p>

                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <strong>Statut:</strong> 
                        <span class="bg-purple-100 text-purple-800 px-3 py-1 rounded text-sm">
                            {{ ticket.status|replace({'_': ' '})|upper }}
                        </span>
                    </div>
                    <div>
                        <strong>Priorité:</strong> {{ ticket.priority|upper }}
                    </div>
                    <div>
                        <strong>Créé le:</strong> {{ ticket.createdAt|date('d/m/Y H:i') }}
                    </div>
                    <div>
                        <strong>Par:</strong> {{ ticket.createdBy.username }}
                    </div>
                </div>

                <div class="bg-gray-50 p-4 rounded mb-4">
                    <strong>Progrès:</strong>
                    <div class="w-full bg-gray-300 rounded-full h-2 mt-2">
                        <div class="bg-green-500 h-2 rounded-full" style="width: {{ ticket.progress }}%"></div>
                    </div>
                    <p class="text-sm text-gray-600 mt-1">{{ ticket.progress }}%</p>
                </div>
            </div>

            <!-- Tasks -->
            {% if ticket.tasks %}
                <div class="bg-white rounded-lg shadow-md p-6 mb-4">
                    <h2 class="text-xl font-bold mb-4">Tâches</h2>
                    <div class="space-y-3">
                        {% for task in ticket.tasks %}
                            <div class="border-l-4 border-purple-500 pl-4 py-2">
                                <div class="flex justify-between items-center">
                                    <span class="font-semibold">{{ task.stepCode }}</span>
                                    <span class="text-xs {% if task.status == 'done' %}text-green-600{% elseif task.status == 'in_progress' %}text-yellow-600{% else %}text-gray-600{% endif %}">
                                        {{ task.status|replace({'_': ' '})|upper }}
                                    </span>
                                </div>
                                <p class="text-sm text-gray-600 mt-1">{{ task.description }}</p>
                                {% if task.requiresCapture and task.capturePath %}
                                    <div class="mt-2 text-sm">
                                        <a href="{{ asset('uploads/ticket_proofs/' ~ task.capturePath) }}" target="_blank" class="text-blue-600 hover:underline">
                                            📎 Capture jointe
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        <!-- Sidebar -->
        <div>
            <!-- Validate Form -->
            <div class="bg-white rounded-lg shadow-md p-6 mb-4">
                <h2 class="text-lg font-bold mb-4">Validation Backhaul</h2>
                <form method="POST" action="{{ path('user_backhaul_validate', {id: ticket.id}) }}">
                    <div class="mb-4">
                        <label for="comment" class="block text-sm font-semibold mb-2">Commentaire:</label>
                        <textarea id="comment" name="comment" rows="3" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
                    </div>
                    <button type="submit" class="w-full bg-green-600 text-white py-2 rounded hover:bg-green-700">
                        ✓ Valider
                    </button>
                </form>
            </div>

            <!-- Ticket Info -->
            <div class="bg-gray-50 rounded-lg p-4">
                <h3 class="font-bold mb-3">Informations</h3>
                <div class="text-sm space-y-2">
                    <p><strong>Service:</strong> BACKHAUL</p>
                    <p><strong>Type:</strong> {{ ticket.actionType }}</p>
                    <p><strong>Créé par:</strong> {{ ticket.createdBy.username }}</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
