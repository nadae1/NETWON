{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<div class="workflow-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">Alertes</h2>
            <div class="page-desc">Sites critiques et retards de workflow</div>
        </div>
    </div>

    {# Statistiques et graphique #}
    <div style="display: flex; gap: 30px; margin-bottom: 30px; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 150px;">
            <div style="background: #f8fafc; border-radius: 16px; padding: 20px; text-align: center; border: 1px solid #e2e8f0;">
                <div style="font-size: 32px; font-weight: 800; color: #dc2626;">{{ nbDelayAlerts }}</div>
                <div style="color: #475569;">Tickets en retard</div>
            </div>
        </div>
        <div style="flex: 1; min-width: 150px;">
            <div style="background: #f8fafc; border-radius: 16px; padding: 20px; text-align: center; border: 1px solid #e2e8f0;">
                <div style="font-size: 32px; font-weight: 800; color: #dc2626;">{{ nbCriticalSites }}</div>
                <div style="color: #475569;">Sites critiques</div>
            </div>
        </div>
        <div style="flex: 2; min-width: 250px; height: 150px;">
            <canvas id="alertsChart" style="width:100%; height:100%;"></canvas>
        </div>
    </div>

    {# Tableau des alertes de retard #}
    <div class="card">
        <h3 class="panel-title">🔴 Alertes de retard de workflow</h3>
        {% set deadlineNotifications = notifications|filter(n => n.type starts with 'deadline_') %}
        {% if deadlineNotifications is empty %}
            <div class="empty-state">✅ Aucune alerte de retard.</div>
        {% else %}
            <table class="workflow-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Ticket</th>
                        <th>Titre</th>
                        <th>Statut</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    {% for n in deadlineNotifications %}
                        <tr>
                            <td>{{ n.createdAt|date('d/m/Y H:i') }}</td>
                            <td>
                                {% if n.type == 'deadline_overdue' %}
                                    <span class="badge red">🚨 Dépassé</span>
                                {% elseif n.type == 'deadline_yellow' or n.type == 'deadline_red' %}
                                    <span class="badge orange">🟡 Alerte</span>
                                {% else %}
                                    {{ n.type }}
                                {% endif %}
                            </td>
                            <td>
                                {% if n.ticket %}
<a href="{{ path('user_workflow_show', {id: n.ticket.id}) }}">#{{ n.ticket.id }}</a>                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>{{ n.ticket ? n.ticket.title : '-' }}</td>
                            <td>
                                {% if n.ticket %}
                                    <span class="badge badge-{{ n.ticket.status|replace({'_': '-'}) }}">
                                        {{ n.ticket.status|replace({'_': ' '})|upper }}
                                    </span>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>{{ n.message }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {# Tableau des sites critiques #}
    <div class="card" style="margin-top: 30px;">
        <h3 class="panel-title">📡 Alertes réseau (sites critiques)</h3>
        {% if criticalSites is empty %}
            <div class="empty-state">✅ Aucune alerte critique</div>
        {% else %}
            <table class="workflow-table">
                <thead>
                    <tr>
                        <th>Site</th>
                        <th>Service</th>
                        <th>Classification</th>
                        <th>Occurrences</th>
                        <th>Date max</th>
                        <th>Trafic Max</th>
                    </tr>
                </thead>
                <tbody>
                    {% for site in criticalSites %}
                        <tr>
                            <td>{{ site.siteName }}</td>
                            <td>{{ site.serviceName }}</td>
                            <td>{{ site.classification }}</td>
                            <td>{{ site.nombreOccurrences }}</td>
                            <td>{{ site.dateMax|date('d/m/Y H:i') }}</td>
                            <td>{{ site.maxTrafic|number_format(2, '.', ' ') }} Mbps</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('alertsChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Tickets en retard', 'Sites critiques'],
                datasets: [{
                    label: 'Nombre d\'alertes',
                    data: [{{ nbDelayAlerts }}, {{ nbCriticalSites }}],
                    backgroundColor: ['#ef4444', '#f59e0b'],
                    borderRadius: 6,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    });
</script>

<style>
    .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .badge.red { background: #fee2e2; color: #dc2626; }
    .badge.orange { background: #fef3c7; color: #d97706; }
    .badge-open { background: #dbeafe; color: #2563eb; }
    .badge-in_progress { background: #fef3c7; color: #d97706; }
    .badge-completed { background: #dcfce7; color: #16a34a; }
    .badge-closed { background: #e2e8f0; color: #475569; }
    .badge-blocked { background: #fee2e2; color: #dc2626; }
</style>
{% endblock %}