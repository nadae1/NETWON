{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<div class="bg-white rounded-xl shadow p-6">
        <h1 class="text-2xl font-bold mb-3">Ticket #{{ ticket.id }} - {{ ticket.title }}</h1>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
            <div>
                <p class="text-gray-700 mb-2"><strong>Statut :</strong> {{ ticket.status|replace({'_': ' '})|upper }}</p>
                <p class="text-gray-700 mb-2"><strong>Deadline :</strong> {{ ticket.deadlineAt ? ticket.deadlineAt|date('d/m/Y H:i') : 'Non définie' }}</p>
                <p class="text-gray-700 mb-2"><strong>Sites :</strong>
                    {% for ts in ticket.ticketSites %}
                        {{ ts.siteName }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        N/A
                    {% endfor %}
                </p>
                <p class="text-gray-700 mb-2"><strong>Action recommandée :</strong> {{ ticket.actionType|default('N/A') }}</p>
            </div>
            <div>
                <p class="text-gray-700 mb-2"><strong>Assignés :</strong>
                    {% for user in ticket.assignedUsers|default([]) %}
                        {{ user.username }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        N/A
                    {% endfor %}
                </p>
                <p class="text-gray-700 mb-2"><strong>Créé par :</strong> {{ ticket.createdBy.username|default('N/A') }}</p>
                <p class="text-gray-700 mb-2"><strong>Progression :</strong> {{ ticket.progress|default(0) }}%</p>
            </div>
        </div>

        <section class="mb-8">
            <h2 class="text-xl font-semibold mb-4">Étapes séquentielles</h2>
            {% include 'dashboard/user/_task_checkboxes.html.twig' with {ticket: ticket, tasks: tasks, updateRoute: 'user_ip_task_update'} %}
        </section>

        <section class="mb-8">
            <h2 class="text-xl font-semibold mb-4">Demande d'intervention externe</h2>
            {% include 'dashboard/user/_subworkflow_modal.html.twig' with {ticket: ticket, services: services, actionRoute: 'user_ip_subworkflow'} %}
        </section>

        <section class="mb-8">
            <h2 class="text-xl font-semibold mb-4">Validation finale</h2>
            <form method="post" action="{{ path('user_ip_task_update', {id: ticket.id, taskId: tasks|first.id}) }}" enctype="multipart/form-data" class="bg-gray-50 rounded-lg p-4">
                {% include 'dashboard/user/_upload_capture.html.twig' %}
                <div class="mb-4">
                    <label class="inline-flex items-center gap-2 text-sm">
                        <input type="checkbox" name="completed" value="1" class="rounded" />
                        <span>Trafic stabilisé / capacité suffisante</span>
                    </label>
                </div>
                <button type="submit" name="workflow_action" value="final_validation" class="bg-green-600 text-white px-4 py-2 rounded">Valider et clôturer</button>
            </form>
        </section>

        <section class="bg-gray-50 p-4 rounded mb-6">
            <h2 class="text-xl font-semibold mb-3">Proposer mise à jour du site</h2>
            <form method="post" action="{{ path('user_ip_propose_update', {id: ticket.id}) }}">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <input type="text" name="new_capacity" placeholder="Nouvelle capacité (Mbps)" class="border rounded p-2" />
                    <input type="text" name="new_support_type" placeholder="Type de support" class="border rounded p-2" />
                    <select name="new_status" class="border rounded p-2">
                        <option value="secured">Sécurisé</option>
                        <option value="warning">À surveiller</option>
                    </select>
                </div>
                <button type="submit" class="mt-4 bg-blue-600 text-white px-4 py-2 rounded">Proposer mise à jour</button>
            </form>
        </section>

        <section class="mb-6">
            <h2 class="text-xl font-semibold mb-4">Commentaires</h2>
            {% for comment in ticket.comments %}
                <div class="border-b border-gray-200 py-3">
                    <p class="text-sm text-gray-600">{{ comment.createdAt|date('d/m/Y H:i') }} - {{ comment.user.username }}</p>
                    <p class="mt-2">{{ comment.message }}</p>
                    {% if comment.filePath %}
                        <p class="text-sm"><a href="{{ asset(comment.filePath) }}" target="_blank" class="text-blue-600">Voir pièce jointe</a></p>
                    {% endif %}
                </div>
            {% else %}
                <div class="text-gray-600">Aucun commentaire pour l’instant.</div>
            {% endfor %}
        </section>

        <section>
            <h2 class="text-xl font-semibold mb-4">Ajouter un commentaire</h2>
            <form method="post" action="{{ path('user_ip_ticket_comment', {id: ticket.id}) }}" enctype="multipart/form-data" class="bg-gray-50 rounded-lg p-4">
                <textarea name="comment" rows="4" class="w-full border rounded p-3 mb-4" placeholder="Écrire un commentaire"></textarea>
                <label class="block text-sm font-medium mb-2">Pièce jointe (optionnelle)</label>
                <input type="file" name="comment_file" class="w-full border rounded p-2 mb-4" />
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Ajouter le commentaire</button>
            </form>
        </section>
    </div>
{% endblock %}