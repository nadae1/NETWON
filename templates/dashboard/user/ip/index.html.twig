{% extends 'dashboard/base_dashboard.html.twig' %}

{% block body %}
<div class="container mx-auto p-6">
    <h1 class="text-2xl font-bold mb-4">Mes tickets FO</h1>
    <div class="overflow-x-auto">
        <table class="min-w-full bg-white border">
            <thead class="bg-gray-100">
                <tr>
                    <th>ID</th><th>Titre</th><th>Sites</th><th>Statut</th><th>Deadline</th><th>Action</th>
                </tr>
            </thead>
            <tbody>
            {% for ticket in tickets %}
                <tr>
                    <td>#{{ ticket.id }}</td>
                    <td>{{ ticket.title }}</td>
                    <td>{{ ticket.ticketSites|map(ts => ts.siteName)|join(', ') }}</td>
                    <td>{{ ticket.status }}</td>
                    <td>{{ ticket.deadlineAt ? ticket.deadlineAt|date('d/m/Y') : '-' }}</td>
                    <td><a href="{{ path('user_ip_ticket_show', {id: ticket.id}) }}" class="text-blue-600">Ouvrir</a></td>
                </tr>
            {% else %}
                <tr><td colspan="6">Aucun ticket</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}