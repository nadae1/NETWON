{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<div class="container mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">Tableau de bord IP</h1>
    <p class="text-gray-600 mb-4">Tickets assignés à vous et à votre service.</p>

    {% if tickets is empty %}
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded">
            Aucun ticket assigné pour le moment.
        </div>
    {% else %}
        <div class="overflow-x-auto bg-white rounded-lg shadow p-4">
            <table class="min-w-full text-left">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-4 py-3">ID</th>
                        <th class="px-4 py-3">Titre</th>
                        <th class="px-4 py-3">Statut</th>
                        <th class="px-4 py-3">Site</th>
                        <th class="px-4 py-3">Deadline</th>
                        <th class="px-4 py-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ticket in tickets %}
                        <tr class="border-b hover:bg-gray-50">
                            <td class="px-4 py-3">#{{ ticket.id }}</td>
                            <td class="px-4 py-3">{{ ticket.title }}</td>
                            <td class="px-4 py-3">{{ ticket.status|replace({'_': ' '})|upper }}</td>
                            <td class="px-4 py-3">{{ ticket.ticketSites|map(ts => ts.siteName)|join(', ') }}</td>
                            <td class="px-4 py-3">{{ ticket.deadlineAt ? ticket.deadlineAt|date('d/m/Y') : '-' }}</td>
                            <td class="px-4 py-3">
                                <a href="{{ path('user_ip_ticket_show', {id: ticket.id}) }}" class="text-blue-600 hover:underline">Voir</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
