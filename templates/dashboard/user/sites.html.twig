{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<div class="workflow-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">{{ pageTitle|default('Sites') }}</h2>
            <div class="page-desc">Sites filtrés par votre service</div>
        </div>
        <div>
            <a href="{{ path('dashboard_import') }}" class="btn-primary">+ Nouvel Import</a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card" style="margin-bottom: 20px;">
        <form method="get" class="filters-form">
            <div class="filter-group">
                <label>Classification</label>
                <select name="classification">
                    <option value="">Toutes</option>
                    {% for class in classifications %}
                        <option value="{{ class }}" {% if currentClassification == class %}selected{% endif %}>{{ class }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-group">
                <label>Recherche</label>
                <input type="text" name="search" value="{{ currentSearch }}" placeholder="Nom du site...">
            </div>
            <div class="filter-group">
                <button type="submit" class="btn-secondary">Filtrer</button>
                <a href="{{ path('user_dashboard_sites') }}" class="btn-link">Réinitialiser</a>
            </div>
        </form>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="workflow-table">
                <thead>
                    <tr>
                        <th>Site</th>
                        <th>Site pairé</th>
                        <th>Classification</th>
                        <th>Type Trans</th>
                        <th>Max Trafic</th>
                        <th>Date Max</th>
                        <th>Occurrences</th>
                        <th>État</th>
                    </tr>
                </thead>
                <tbody>
                    {% for site in sites %}
                        <tr>
                            <td><strong>{{ site.siteName }}</strong></td>
                            <td>{{ site.pairedSiteName ?: '-' }}</td>
                            <td>{{ site.classification ?: '-' }}</td>
                            <td>{{ site.typeTrans ?: '-' }}</td>
                            <td>{{ site.maxTrafic|number_format(2, '.', ' ') }}</td>
                            <td>{{ site.dateMax ? site.dateMax|date('d/m/Y H:i') : '-' }}</td>
                            <td>{{ site.nombreOccurrences }}</td>
                            <td>
                                {% if site.isCritical %}
                                    <span class="badge red">Critique</span>
                                {% else %}
                                    <span class="badge green">Normal</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="empty-state">Aucun site trouvé</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        {% if pagination.totalPages > 1 %}
            <div class="pagination">
                {% for p in 1..pagination.totalPages %}
                    <a href="{{ path('user_dashboard_sites', {page: p, classification: currentClassification, search: currentSearch}) }}" 
                       class="page-link {% if p == pagination.page %}active{% endif %}">{{ p }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<style>
.filters-form {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: flex-end;
}
.filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.filter-group label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
}
.filter-group select, .filter-group input {
    padding: 8px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    min-width: 150px;
}
.btn-secondary {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
}
.btn-link {
    padding: 8px 16px;
    color: #64748b;
    text-decoration: none;
}
.pagination {
    margin-top: 20px;
    display: flex;
    gap: 8px;
    justify-content: center;
}
.page-link {
    padding: 6px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    text-decoration: none;
    color: #3b82f6;
}
.page-link.active {
    background: #3b82f6;
    color: white;
    border-color: #3b82f6;
}
</style>
{% endblock %}