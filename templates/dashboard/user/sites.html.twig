{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<div class="workflow-page">
    <div class="page-header">
        <div>
        </div>
        <div>
            <a href="{{ path('dashboard_import') }}" class="btn-primary">+ Nouvel Import</a>
        </div>
    </div>

    <div class="card" style="margin-bottom: 20px;">
        <form method="get" class="filters-form">
            <div class="filter-group">
                <label>Classification</label>
                <select name="classification">
                    <option value="">Toutes</option>
                    {% for class in classifications %}
                        <option value="{{ class }}" {% if currentClassification == class %}selected{% endif %}>{{ class }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-group">
                <label>État / Statut</label>
                <select name="status">
                    <option value="">Tous</option>
                    {% for value, label in statusOptions %}
                        <option value="{{ value }}" {% if currentStatus == value %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-group">
                <label>Recherche</label>
                <input type="text" name="search" value="{{ currentSearch }}" placeholder="Nom du site...">
            </div>
            <div class="filter-group">
                <button type="submit" class="btn-secondary">Filtrer</button>
                <a href="{{ path('user_dashboard_sites') }}" class="btn-link">Réinitialiser</a>
            </div>
        </form>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="workflow-table">
                <thead>
                    <tr>
                        <th>Site_name</th>
                        <th>Classification</th>
                        <th>Type</th>
                        <th>Max TDD</th>
                        <th>Max FDD</th>
                        <th>Trafic Max</th>
                        <th>Capacité TDD (Mbps)</th>
                        <th>Capacité FDD (Mbps)</th>
                        <th>Taux Utilisation</th>
                        <th>Taux Utilisation TDD</th>
                        <th>Taux Utilisation FDD</th>
                        <th>Occurrences</th>
                        <th>Occurrence TDD</th>
                        <th>Occurrence FDD</th>
                        <th>Statut</th>
                        <th>État</th>
                        <th>DropCong (tdd)</th>
                        <th>DropCong (fdd)</th>
                        <th>DropCong (tf)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for site in sites %}
                        <tr>
                            <td><strong>{{ site.siteName }}</strong></td>
                            <td>{{ site.classification ?: '-' }}</td>
                            <td>{{ site.typeTrans ?: '-' }}</td>
                            <td>{{ site.maxTraficTdd is not null ? site.maxTraficTdd|number_format(2, '.', ' ') : '-' }}</td>
                            <td>{{ site.maxTraficFdd is not null ? site.maxTraficFdd|number_format(2, '.', ' ') : '-' }}</td>
                            <td>{{ site.maxTrafic is not null ? site.maxTrafic|number_format(2, '.', ' ') : '-' }}</td>
                            <td>{{ site.capaciteTddMbps is not null ? site.capaciteTddMbps|number_format(2, '.', ' ') : '-' }}</td>
                            <td>{{ site.capaciteFddMbps is not null ? site.capaciteFddMbps|number_format(2, '.', ' ') : '-' }}</td>
                            <td>{{ site.tauxUtilisation is not null ? site.tauxUtilisation|number_format(2, '.', ' ') ~ '%' : '-' }}</td>
                            <td>{{ site.tauxUtilisationTdd is not null ? site.tauxUtilisationTdd|number_format(2, '.', ' ') ~ '%' : '-' }}</td>
                            <td>{{ site.tauxUtilisationFdd is not null ? site.tauxUtilisationFdd|number_format(2, '.', ' ') ~ '%' : '-' }}</td>
                            <td>{{ site.nombreOccurrences }}</td>
                            <td>{{ site.nombreOccurrencesTdd is not null ? site.nombreOccurrencesTdd : '-' }}</td>
                            <td>{{ site.nombreOccurrencesFdd is not null ? site.nombreOccurrencesFdd : '-' }}</td>
                            <td>{{ site.status ?: '-' }}</td>
                            <td>
                                {# ✅ CORRIGÉ : comparaison alignée sur les vraies valeurs
                                   produites par le pipeline Python. #}
                                {% set st = site.siteStatus %}
                                {% if st == 'CRITIQUE' %}
                                    <span class="badge red">Critique</span>
                                {% elseif st == 'SURVEILLANCE' %}
                                    <span class="badge orange">Sous observation</span>
                                {% elseif st == 'SECURISE' %}
                                    <span class="badge green">Sécurisé</span>
                                {% elseif st == 'ERREUR_EVALUATION' %}
                                    <span class="badge gray">Erreur d'évaluation</span>
                                {% else %}
                                    <span class="badge gray">Non évalué</span>
                                {% endif %}
                            </td>
                            <td>{{ site.dropCongTdd is not null ? site.dropCongTdd : '-' }}</td>
                            <td>{{ site.dropCongFdd is not null ? site.dropCongFdd : '-' }}</td>
                            <td>{{ site.dropCongTf is not null ? site.dropCongTf : '-' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="19" class="empty-state">Aucun site trouvé</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pagination.totalPages > 1 %}
            <div class="pagination">
                {% for p in 1..pagination.totalPages %}
                    <a href="{{ path('user_dashboard_sites', {page: p, classification: currentClassification, status: currentStatus, search: currentSearch}) }}"
                       class="page-link {% if p == pagination.page %}active{% endif %}">{{ p }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<style>
.filters-form {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: flex-end;
}
.filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.filter-group label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
}
.filter-group select, .filter-group input {
    padding: 8px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    min-width: 150px;
}
.btn-secondary {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
}
.btn-link {
    padding: 8px 16px;
    color: #64748b;
    text-decoration: none;
}
.pagination {
    margin-top: 20px;
    display: flex;
    gap: 8px;
    justify-content: center;
}
.page-link {
    padding: 6px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    text-decoration: none;
    color: #3b82f6;
}
.page-link.active {
    background: #3b82f6;
    color: white;
    border-color: #3b82f6;
}
.badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}
.badge.red { background: #fee2e2; color: #dc2626; }
.badge.orange { background: #ffedd5; color: #ea580c; }
.badge.green { background: #dcfce7; color: #16a34a; }
.badge.gray { background: #f1f5f9; color: #64748b; }
</style>
{% endblock %}