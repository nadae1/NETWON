{% extends 'dashboard/base_dashboard.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block content %}
<div class="container mx-auto p-4">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">Gestion des Utilisateurs</h1>
        <a href="{{ path('admin_user_new') }}" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
            + Nouvel Utilisateur
        </a>
    </div>

    {% if users is empty %}
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded">
            Aucun utilisateur trouvé.
        </div>
    {% else %}
        <div class="bg-white rounded-lg shadow overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-gray-100 border-b">
                    <tr>
                        <th class="px-6 py-3 font-semibold">Nom d'utilisateur</th>
                        <th class="px-6 py-3 font-semibold">Email</th>
                        <th class="px-6 py-3 font-semibold">Service</th>
                        <th class="px-6 py-3 font-semibold">Département</th>
                        <th class="px-6 py-3 font-semibold">Rôles</th>
                        <th class="px-6 py-3 font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr class="border-b hover:bg-gray-50">
                            <td class="px-6 py-3">{{ user.username }}</td>
                            <td class="px-6 py-3">{{ user.email }}</td>
                            <td class="px-6 py-3">{{ user.service ?? 'N/A' }}</td>
                            <td class="px-6 py-3">{{ user.department ?? 'N/A' }}</td>
                            <td class="px-6 py-3">
                                {% for role in user.roles %}
                                    <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded mr-1">
                                        {{ role|replace({'ROLE_': ''})|upper }}
                                    </span>
                                {% endfor %}
                            </td>
                            <td class="px-6 py-3">
                                <div class="flex gap-2">
                                    <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="text-blue-600 hover:underline text-xs">
                                        Éditer
                                    </a>
                                    <form method="POST" action="{{ path('admin_user_delete', {id: user.id}) }}" class="inline">
                                        <button type="submit" class="text-red-600 hover:underline text-xs" onclick="return confirm('Êtes-vous sûr?')">
                                            Supprimer
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
