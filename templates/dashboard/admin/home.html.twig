{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>

<style>
    /* ... vos styles (inchangés) ... */
</style>

<div class="admin-dashboard">
    <div class="page-header">
        <div>
            <h2 class="page-title">Admin Dashboard</h2>
            <div class="page-desc">Vue globale d'administration - consultation et export uniquement</div>
        </div>
        <div>
            <a href="{{ path('admin_export_statistics_pdf') }}" class="btn-primary">📥 Exporter les données</a>
        </div>
    </div>

    <!-- 4 cartes statistiques -->
    <div class="stats-grid">
        <div class="stat-card stat-blue">
            <div>
                <div class="stat-label">Total Sites</div>
                <div class="stat-value">{{ totalSites }}</div>
                <div class="stat-small">
                    {{ serviceDistribution.FO|default(0) }} FO •
                    {{ serviceDistribution.FH|default(0) }} FH •
                    {{ serviceDistribution.SHARED|default(0) }} SHARED
                </div>
            </div>
            <div class="stat-icon icon-blue">📡</div>
        </div>

        <div class="stat-card stat-red">
            <div>
                <div class="stat-label">Sites Critiques</div>
                <div class="stat-value">{{ criticalSites }}</div>
                <div class="stat-small">{{ criticalPercentage }}% du total</div>
            </div>
            <div class="stat-icon icon-red">⚠️</div>
        </div>

        <div class="stat-card stat-green">
            <div>
                <div class="stat-label">Trafic Moyen</div>
                <div class="stat-value">{{ avgTraffic }}</div>
                <div class="stat-small">Mbps</div>
            </div>
            <div class="stat-icon icon-green">📊</div>
        </div>

        <div class="stat-card stat-purple">
            <div>
                <div class="stat-label">Services Actifs</div>
                <div class="stat-value">{{ serviceDistribution|length }}</div>
                <div class="stat-small">{{ serviceDistribution|keys|join(' / ') }}</div>
            </div>
            <div class="stat-icon icon-purple">🏷️</div>
        </div>
    </div>

    <!-- Filtres -->
    <form method="get" action="{{ path('admin_dashboard_home') }}" class="filters-bar">
        <label>Service :
            <select name="service">
                <option value="">Tous</option>
                {% for svc in allServices %}
                    <option value="{{ svc }}" {% if svc == currentService %}selected{% endif %}>{{ svc }}</option>
                {% endfor %}
            </select>
        </label>
        <label>Classification :
            <select name="classification">
                <option value="">Toutes</option>
                {% for class in allClassifications %}
                    <option value="{{ class }}" {% if class == currentClassification %}selected{% endif %}>{{ class }}</option>
                {% endfor %}
            </select>
        </label>
        <label>État critique :
            <select name="critical">
                <option value="">Tous</option>
                <option value="1" {% if currentCritical == '1' %}selected{% endif %}>Critique</option>
                <option value="0" {% if currentCritical == '0' %}selected{% endif %}>Normal</option>
            </select>
        </label>
        <button type="submit" class="btn">Filtrer</button>
        <a href="{{ path('admin_dashboard_home') }}" class="btn btn-outline">Réinitialiser</a>
    </form>

    <!-- Carte -->
    <div class="map-container" id="mapContainer">
        <div id="map"></div>
        <button class="map-export-btn" id="exportMapBtn">📷 Exporter la carte</button>
    </div>

    <!-- Graphiques -->
    <div class="charts-grid">
        <div class="chart-card">
            <div class="chart-title">Classification des sites</div>
            <div class="chart-box">
                <canvas id="classificationChart"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-title">Distribution par service</div>
            <div class="chart-box">
                <canvas id="serviceDonut"></canvas>
            </div>
            <div class="legend">
                <div class="legend-item"><span class="legend-dot dot-blue"></span> FO ({{ serviceDistribution.FO|default(0) }})</div>
                <div class="legend-item"><span class="legend-dot dot-green"></span> FH ({{ serviceDistribution.FH|default(0) }})</div>
                <div class="legend-item"><span class="legend-dot dot-purple"></span> SHARED ({{ serviceDistribution.SHARED|default(0) }})</div>
            </div>
        </div>
    </div>

    <!-- Derniers sites -->
    <div class="card" style="margin-top:30px;">
        <h3 class="panel-title">Derniers sites traités</h3>
        {% if sites is empty %}
            <div class="empty-state">Aucune donnée importée.</div>
        {% else %}
            <div class="table-like">
                <div class="table-row" style="background:#f8fafc; font-weight:600;">
                    <div>Site</div>
                    <div>Service</div>
                    <div>Classification</div>
                    <div>Type Trans</div>
                    <div>Trafic Max</div>
                    <div>État</div>
                </div>
                {% for site in sites|slice(0, 5) %}
                    <div class="table-row">
                        <div><strong>{{ site.siteName }}</strong></div>
                        <div><span class="badge" style="background:#e2e8f0;">{{ site.service ?? '-' }}</span></div>
                        <div>{{ site.classification ?? '-' }}</div>
                        <div>{{ site.typeTrans ?? '-' }}</div>
                        <div>{{ site.maxTrafic|number_format(2, '.', ' ') }} Mbps</div>
                        <div>
                            {% if site.isCritical %}
                                <span class="badge red">Critique</span>
                            {% else %}
                                <span class="badge green">Normal</span>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="view-all-link">
                <a href="{{ path('admin_dashboard_sites') }}" class="btn-outline">Voir tous les sites →</a>
            </div>
        {% endif %}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // Graphiques
    const classificationStats = {{ classificationStats|json_encode|raw }};
    const serviceDistribution = {{ serviceDistribution|json_encode|raw }};

    const labels = Object.keys(classificationStats);
    const totalData = labels.map(label => classificationStats[label]?.total || 0);
    const criticalData = labels.map(label => classificationStats[label]?.critical || 0);

    if (document.getElementById('classificationChart')) {
        new Chart(document.getElementById('classificationChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Total', data: totalData, backgroundColor: '#3b82f6', borderRadius: 6 },
                    { label: 'Critique', data: criticalData, backgroundColor: '#ef4444', borderRadius: 6 }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    tooltip: {
                        backgroundColor: '#ffffff',
                        titleColor: '#020617',
                        bodyColor: '#2563eb',
                        borderColor: '#e2e8f0',
                        borderWidth: 1,
                        padding: 14
                    },
                    legend: { position: 'bottom' }
                },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'Nombre de sites' }, grid: { color: '#e2e8f0' } },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    if (document.getElementById('serviceDonut')) {
        new Chart(document.getElementById('serviceDonut'), {
            type: 'doughnut',
            data: {
                labels: ['FO', 'FH', 'SHARED'],
                datasets: [{
                    data: [
                        serviceDistribution.FO || 0,
                        serviceDistribution.FH || 0,
                        serviceDistribution.SHARED || 0
                    ],
                    backgroundColor: ['#3b82f6', '#14b8a6', '#8b5cf6'],
                    borderColor: '#ffffff',
                    borderWidth: 4,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '55%',
                plugins: {
                    tooltip: {
                        backgroundColor: '#ffffff',
                        titleColor: '#020617',
                        bodyColor: '#2563eb',
                        borderColor: '#e2e8f0',
                        borderWidth: 1,
                        padding: 14
                    },
                    legend: { display: false }
                }
            }
        });
    }

    // Carte Leaflet
    const sitesData = {{ sites|json_encode|raw }};
    console.log('Données carte :', sitesData); // débogage

    if (sitesData.length === 0) {
        document.getElementById('map').innerHTML = '<p style="text-align:center;padding:60px;color:#64748b;">Aucun site géolocalisé. Importez des coordonnées via l\'option Import du Superuser.</p>';
    } else {
        const map = L.map('map').setView([34.0, 9.0], 7);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        const markers = L.markerClusterGroup();

        // Icônes personnalisées
        const criticalIcon = L.divIcon({
            className: 'custom-div-icon',
            html: '<div style="background:#ef4444;width:18px;height:18px;border-radius:50%;border:2px solid white;box-shadow:0 0 6px rgba(0,0,0,0.4);"></div>',
            iconSize: [18, 18],
            iconAnchor: [9, 9]
        });
        const warningIcon = L.divIcon({
            className: 'custom-div-icon',
            html: '<div style="background:#f59e0b;width:18px;height:18px;border-radius:50%;border:2px solid white;box-shadow:0 0 6px rgba(0,0,0,0.4);"></div>',
            iconSize: [18, 18],
            iconAnchor: [9, 9]
        });
        const safeIcon = L.divIcon({
            className: 'custom-div-icon',
            html: '<div style="background:#10b981;width:18px;height:18px;border-radius:50%;border:2px solid white;box-shadow:0 0 6px rgba(0,0,0,0.4);"></div>',
            iconSize: [18, 18],
            iconAnchor: [9, 9]
        });

        sitesData.forEach(site => {
            if (site.latitude && site.longitude) {
                const lat = parseFloat(site.latitude);
                const lng = parseFloat(site.longitude);
                let icon;
                if (site.isCritical) {
                    icon = criticalIcon;
                } else if (site.maxTrafic && parseFloat(site.maxTrafic) > 1000) {
                    icon = warningIcon;
                } else {
                    icon = safeIcon;
                }
                const popupContent = `
                    <strong>${site.siteName}</strong><br>
                    Service: ${site.service || 'N/A'}<br>
                    Classification: ${site.classification || 'N/A'}<br>
                    Trafic max: ${site.maxTrafic || 0} Mbps<br>
                    État: ${site.isCritical ? '⚠️ Critique' : (parseFloat(site.maxTrafic) > 1000 ? '🟡 Sous observation' : '✅ Sécurisé')}
                `;
                const marker = L.marker([lat, lng], { icon: icon })
                    .bindPopup(popupContent);
                markers.addLayer(marker);
            }
        });

        map.addLayer(markers);
        if (markers.getLayers().length > 0) {
            const group = L.featureGroup(markers.getLayers());
            map.fitBounds(group.getBounds().pad(0.1));
        }
    }

    // Export de la carte
    document.getElementById('exportMapBtn').addEventListener('click', function() {
        const mapContainer = document.getElementById('mapContainer');
        html2canvas(mapContainer, {
            useCORS: true,
            allowTaint: true,
            backgroundColor: '#ffffff'
        }).then(canvas => {
            const link = document.createElement('a');
            link.download = 'carte_sites.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
        }).catch(err => {
            alert('Erreur lors de l\'export : ' + err);
        });
    });
});
</script>
{% endblock %}