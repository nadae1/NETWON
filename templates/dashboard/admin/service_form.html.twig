{% extends 'base_dashboard.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="container mx-auto p-4 max-w-2xl">
    <div class="mb-6">
        <a href="{{ path('admin_services') }}" class="text-blue-600 hover:underline">← Retour à la liste</a>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
        <h1 class="text-2xl font-bold mb-6">{{ title }}</h1>

        {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class="space-y-4">
            <div>
                {{ form_label(form.name, "Nom du Service") }}
                {{ form_widget(form.name, {attr: {class: 'w-full border border-gray-300 rounded px-3 py-2'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div>
                {{ form_label(form.description, "Description") }}
                {{ form_widget(form.description, {attr: {class: 'w-full border border-gray-300 rounded px-3 py-2', rows: 3}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    {{ form_label(form.color, "Couleur (Hex)") }}
                    {{ form_widget(form.color, {attr: {class: 'w-full border border-gray-300 rounded px-3 py-2', type: 'color'}}) }}
                    {{ form_errors(form.color) }}
                </div>

                <div>
                    {{ form_label(form.defaultDeadlineDays, "Délai par défaut (jours)") }}
                    {{ form_widget(form.defaultDeadlineDays, {attr: {class: 'w-full border border-gray-300 rounded px-3 py-2'}}) }}
                    {{ form_errors(form.defaultDeadlineDays) }}
                </div>
            </div>
        </div>

        <div class="mt-6 flex gap-3">
            <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700">
                Enregistrer
            </button>
            <a href="{{ path('admin_services') }}" class="bg-gray-400 text-white px-6 py-2 rounded hover:bg-gray-500">
                Annuler
            </a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
