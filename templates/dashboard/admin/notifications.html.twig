{% extends 'dashboard/base_dashboard.html.twig' %}

{% block title %}Journaux de Notifications{% endblock %}

{% block content %}
<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6">Journaux de Notifications (Dernières 100)</h1>

    {% if notifications is empty %}
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded">
            Aucune notification trouvée.
        </div>
    {% else %}
        <div class="bg-white rounded-lg shadow overflow-x-auto">
            <table class="w-full text-left text-xs md:text-sm">
                <thead class="bg-gray-100 border-b">
                    <tr>
                        <th class="px-4 md:px-6 py-3 font-semibold">Date</th>
                        <th class="px-4 md:px-6 py-3 font-semibold">Utilisateur</th>
                        <th class="px-4 md:px-6 py-3 font-semibold">Type</th>
                        <th class="px-4 md:px-6 py-3 font-semibold">Message</th>
                        <th class="px-4 md:px-6 py-3 font-semibold">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for notification in notifications %}
                        <tr class="border-b hover:bg-gray-50">
                            <td class="px-4 md:px-6 py-3">{{ notification.createdAt|date('d/m/Y H:i') }}</td>
                            <td class="px-4 md:px-6 py-3">{{ notification.recipient.username }}</td>
                            <td class="px-4 md:px-6 py-3">
                                <span class="inline-block bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">
                                    {{ notification.type|upper }}
                                </span>
                            </td>
                            <td class="px-4 md:px-6 py-3 truncate max-w-xs">{{ notification.message }}</td>
                            <td class="px-4 md:px-6 py-3">
                                {% if notification.isRead %}
                                    <span class="text-green-600 text-xs">✓ Lu</span>
                                {% else %}
                                    <span class="text-orange-600 text-xs">⊙ Non lu</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
