{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>

<style>
.kpis-page { padding: 20px; }
.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
.page-title { font-size: 28px; font-weight: 700; color: #07152f; margin: 0; }
.page-desc { color: #60708a; font-size: 15px; margin-top: 6px; }

.filters { display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap; align-items: center; background: #f8fafc; padding: 15px 20px; border-radius: 12px; border: 1px solid #e2e8f0; }
.filters label { font-weight: 600; margin-right: 5px; }
.filters select, .filters input { padding: 8px 14px; border-radius: 8px; border: 1px solid #cbd5e1; background: white; }
.filters .btn { padding: 8px 20px; border-radius: 8px; background: #3b82f6; color: white; border: none; font-weight: 600; cursor: pointer; }

.chart-container { background: white; padding: 24px; border-radius: 16px; border: 1px solid #dbe3ef; margin-bottom: 30px; position: relative; }
#kpiChart { height: 400px; width: 100%; }
#chartWrapper { min-height: 400px; }

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 20px;
}
.stat-card {
    background: white;
    border-radius: 16px;
    padding: 20px;
    border: 1px solid #e2e8f0;
    text-align: center;
}
.stat-card .label { font-size: 13px; color: #64748b; text-transform: uppercase; font-weight: 600; }
.stat-card .value { font-size: 28px; font-weight: 700; color: #020617; margin-top: 6px; }
.stat-card .sub { font-size: 12px; color: #94a3b8; margin-top: 4px; }
.stat-blue .value { color: #3b82f6; }
.stat-green .value { color: #10b981; }
.stat-orange .value { color: #f59e0b; }
.stat-red .value { color: #ef4444; }

.loading { text-align: center; padding: 40px; color: #64748b; }
</style>

<div class="kpis-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">📊 KPI – Trafic par site</h2>
        </div>
    </div>

    <!-- Filtres -->
    <div class="filters">
        <div>
            <label for="siteSelect">Site :</label>
            <select id="siteSelect">
                <option value="">-- Choisir un site --</option>
                {% for site in sites %}
                    <option value="{{ site.prefix }}">{{ site.prefix }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="daysSelect">Période :</label>
            <select id="daysSelect">
                <option value="7">7 jours</option>
                <option value="15">15 jours</option>
                <option value="30" selected>30 jours</option>
                <option value="60">60 jours</option>
                <option value="90">90 jours</option>
            </select>
        </div>
        <button id="loadBtn" class="btn">Afficher</button>
    </div>

    <!-- Stats -->
    <div class="stats-grid" id="statsGrid" style="display:none;">
        <div class="stat-card stat-blue">
            <div class="label">Trafic Moyen</div>
            <div class="value" id="avgTraffic">-</div>
            <div class="sub">Mbps</div>
        </div>
        <div class="stat-card stat-red">
            <div class="label">Trafic Max</div>
            <div class="value" id="maxTraffic">-</div>
            <div class="sub">Mbps</div>
        </div>
        <div class="stat-card stat-green">
            <div class="label">Capacité TDD</div>
            <div class="value" id="tddCap">-</div>
            <div class="sub">Mbps</div>
        </div>
        <div class="stat-card stat-orange">
            <div class="label">Capacité FDD</div>
            <div class="value" id="fddCap">-</div>
            <div class="sub">Mbps</div>
        </div>
    </div>

    <!-- Chart -->
    <div class="chart-container">
        <div id="chartWrapper">
            <canvas id="kpiChart"></canvas>
        </div>
        <div id="loadingMsg" class="loading">Sélectionnez un site et cliquez sur "Afficher".</div>
    </div>

    <div style="margin-top:10px;color:#94a3b8;font-size:12px;">
        💡 Courbes horaires du trafic total (TDD+FDD) et séparées. Les lignes pointillées représentent les capacités respectives.
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('kpiChart').getContext('2d');
    let chart = null;
    const loadingMsg = document.getElementById('loadingMsg');
    const statsGrid = document.getElementById('statsGrid');
    const chartWrapper = document.getElementById('chartWrapper');

    function loadData(site, days) {
        if (!site) {
            alert('Veuillez sélectionner un site.');
            return;
        }
        loadingMsg.style.display = 'block';
        statsGrid.style.display = 'none';
        chartWrapper.innerHTML = '<canvas id="kpiChart"></canvas>';

        const url = '{{ path('admin_kpis_data') }}?site=' + encodeURIComponent(site) + '&days=' + days;
        fetch(url)
            .then(response => {
                if (!response.ok) throw new Error('Erreur serveur (status ' + response.status + ')');
                return response.json();
            })
            .then(data => {
                loadingMsg.style.display = 'none';
                if (data.error) {
                    alert('Erreur : ' + data.error);
                    chartWrapper.innerHTML = '<p style="text-align:center;color:#ef4444;">' + data.error + '</p>';
                    return;
                }
                if (data.datasets.every(ds => ds.data.length === 0)) {
                    chartWrapper.innerHTML = '<p style="text-align:center;color:#f59e0b;">Aucune donnée de trafic pour ce site.</p>';
                    statsGrid.style.display = 'none';
                    return;
                }

                // Mettre à jour les stats
                document.getElementById('avgTraffic').textContent = data.avgTrafic || '-';
                document.getElementById('maxTraffic').textContent = data.maxTrafic || '-';
                document.getElementById('tddCap').textContent = data.tddCapacity !== null ? data.tddCapacity : '-';
                document.getElementById('fddCap').textContent = data.fddCapacity !== null ? data.fddCapacity : '-';
                statsGrid.style.display = 'grid';

                // Combiner datasets + capacités
                const allDatasets = [...data.datasets, ...data.capaciteDatasets];

                // Réinitialiser le canvas
                const canvas = document.createElement('canvas');
                canvas.id = 'kpiChart';
                canvas.style.height = '400px';
                canvas.style.width = '100%';
                chartWrapper.innerHTML = '';
                chartWrapper.appendChild(canvas);
                const newCtx = canvas.getContext('2d');

                if (chart) chart.destroy();
                chart = new Chart(newCtx, {
                    type: 'line',
                    data: { datasets: allDatasets },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        parsing: false,
                        plugins: {
                            legend: { position: 'top' },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                callbacks: {
                                    label: function(context) {
                                        return context.dataset.label + ': ' + context.raw.y + ' Mbps';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                type: 'time',
                                time: { unit: 'hour', displayFormats: { hour: 'dd/MM HH:00' } },
                                title: { display: true, text: 'Date / Heure' },
                                grid: { color: '#f1f5f9' }
                            },
                            y: {
                                beginAtZero: true,
                                title: { display: true, text: 'Mbps' },
                                grid: { color: '#f1f5f9' }
                            }
                        }
                    }
                });
            })
            .catch(err => {
                loadingMsg.style.display = 'none';
                alert('Erreur de chargement : ' + err.message);
                chartWrapper.innerHTML = '<p style="text-align:center;color:#ef4444;">Impossible de charger les données.</p>';
            });
    }

    document.getElementById('loadBtn').addEventListener('click', function() {
        const site = document.getElementById('siteSelect').value;
        const days = document.getElementById('daysSelect').value;
        loadData(site, days);
    });

    // Chargement automatique du premier site
    const firstSite = document.getElementById('siteSelect').querySelector('option[value!=""]');
    if (firstSite) {
        document.getElementById('siteSelect').value = firstSite.value;
        loadData(firstSite.value, 30);
    }
});
</script>
{% endblock %}