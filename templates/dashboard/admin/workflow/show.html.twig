{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
.ticket-layout { display:grid; grid-template-columns:2fr 1fr; gap:25px; }
.card { background:white; border:1px solid #e2e8f0; border-radius:16px; padding:24px; margin-bottom:20px; }
.badge { padding:6px 12px; border-radius:20px; background:#e2e8f0; font-weight:700; font-size:12px; }
.actions-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.btn { padding:10px; border:none; border-radius:8px; font-weight:700; cursor:pointer; }
.btn-green { background:#22c55e; color:white; }
.btn-red { background:#ef4444; color:white; }
.btn-blue { background:#3b82f6; color:white; }
.history-item { border-left:4px solid #3b82f6; padding-left:12px; margin-bottom:16px; }
</style>

<h2>Ticket #{{ ticket.reference ?: ticket.id }} - {{ ticket.title }}</h2>

<div class="ticket-layout">
    <div>
        <div class="card">
            <h3>Informations ticket</h3>
            <p><strong>Référence :</strong> {{ ticket.reference ?: ticket.id }}</p>
            <p><strong>Titre :</strong> {{ ticket.title }}</p>
            <p><strong>Site :</strong> {{ ticket.getSiteName() ?: '-' }}</p>
            <p><strong>Service :</strong> {{ ticket.getService() ?: '-' }}</p>
            <p><strong>Type d'action :</strong> {{ ticket.actionType ?: '-' }}</p>
            <p><strong>Statut :</strong> <span class="badge">{{ ticket.status }}</span></p>
            <p><strong>Priorité :</strong> {{ ticket.priority }}</p>
            <p><strong>Étape actuelle :</strong> {{ ticket.currentStep }}</p>
            <p><strong>Progression :</strong> {{ ticket.progress }}%</p>
            <p><strong>Date limite :</strong> {{ ticket.deadlineAt ? ticket.deadlineAt|date('d/m/Y H:i') : '-' }}</p>
            <p><strong>Créé par :</strong> {{ ticket.createdBy ? ticket.createdBy.username : 'Utilisateur inconnu' }}</p>
            <p><strong>Assigné à :</strong> {{ ticket.getAssignedService() ?: '-' }}</p>
            <p><strong>Description :</strong><br>{{ ticket.description ?: '-' }}</p>
        </div>

        <div class="card">
            <h3>Historique</h3>
            {% if ticket.history is not empty %}
                {% for h in ticket.history %}
                    <div class="history-item">
                        <strong>{{ h.action }}</strong><br>
                        <small>{{ h.createdAt|date('d/m/Y H:i') }}</small><br>
                        <span>{{ h.user ? h.user.username : 'Système' }}</span>
                        {% if h.details %}
                            <p>{{ h.details }}</p>
                        {% endif %}
                    </div>
                {% else %}
                    <p>Aucun historique.</p>
                {% endfor %}
            {% else %}
                <p>Aucun historique disponible.</p>
            {% endif %}
        </div>
    </div>

    <div>
        <div class="card">
            <h3>Tâches associées</h3>
            {% if ticket.tasks is empty %}
                <p>Aucune tâche associée à ce ticket.</p>
            {% else %}
                <div class="actions-grid">
                    {% for task in ticket.tasks %}
                        <div class="card" style="margin-bottom:10px;">
                            <strong>{{ task.title }}</strong>
                            <p>Statut : {{ task.status }}</p>
                            <p>Service : {{ task.serviceName ?: '-' }}</p>
                            <p>Étape : {{ task.stepCode ?: '-' }}</p>
                            <p>Assigné à : {{ task.assignedTo ? task.assignedTo.username : '-' }}</p>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}