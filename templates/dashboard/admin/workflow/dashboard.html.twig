{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
.workflow-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-bottom:30px; }
.stat-card { background:white; border:1px solid #e2e8f0; border-radius:16px; padding:22px; }
.stat-title { color:#64748b; font-weight:700; font-size:13px; text-transform:uppercase; }
.stat-value { font-size:36px; font-weight:800; margin-top:8px; }
.page-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:25px; }
.btn-primary { background:#3b82f6; color:white; padding:10px 18px; border-radius:8px; text-decoration:none; font-weight:700; }
.table { width:100%; border-collapse:collapse; background:white; border-radius:14px; overflow:hidden; }
.table th,.table td { padding:14px; border-bottom:1px solid #e2e8f0; text-align:left; }
.badge { padding:5px 10px; border-radius:20px; font-size:12px; font-weight:700; background:#e2e8f0; }
</style>

<div class="page-head">
    <div>
        <h2>Workflow Tickets</h2>
        <p>Gestion complète des tickets FO / IP / Déploiement / KPI</p>
    </div>
    <a href="{{ path('workflow_ticket_new') }}" class="btn-primary">+ Nouveau ticket</a>
</div>

<div class="workflow-grid">
    <div class="stat-card"><div class="stat-title">Créés</div><div class="stat-value">{{ created }}</div></div>
    <div class="stat-card"><div class="stat-title">En cours</div><div class="stat-value">{{ inProgress }}</div></div>
    <div class="stat-card"><div class="stat-title">Bloqués</div><div class="stat-value">{{ blocked }}</div></div>
    <div class="stat-card"><div class="stat-title">Clôturés</div><div class="stat-value">{{ closed }}</div></div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Référence</th>
            <th>Site</th>
            <th>Service</th>
            <th>Étape</th>
            <th>Assigné à</th>
            <th>Statut</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {% for ticket in tickets %}
            <tr>
                <td>{{ ticket.reference }}</td>
                <td>{{ ticket.siteName }}</td>
                <td>{{ ticket.service }}</td>
                <td>{{ ticket.currentStep }}</td>
                <td>{{ ticket.assignedService }}</td>
                <td><span class="badge">{{ ticket.status }}</span></td>
                <td><a href="{{ path('workflow_ticket_show', {id: ticket.id}) }}">Voir</a></td>
            </tr>
        {% else %}
            <tr><td colspan="7">Aucun ticket.</td></tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}