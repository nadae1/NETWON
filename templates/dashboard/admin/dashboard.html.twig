{% extends 'base_dashboard.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block content %}
<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-6">Tableau de Bord Admin</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
        <!-- Stats Cards -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-gray-600 text-sm font-semibold mb-2">Utilisateurs</h3>
            <p class="text-3xl font-bold text-blue-600">{{ stats.total_users }}</p>
            <a href="{{ path('admin_users') }}" class="text-blue-600 text-xs hover:underline mt-2 inline-block">Gérer →</a>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-gray-600 text-sm font-semibold mb-2">Services</h3>
            <p class="text-3xl font-bold text-green-600">{{ stats.total_services }}</p>
            <a href="{{ path('admin_services') }}" class="text-green-600 text-xs hover:underline mt-2 inline-block">Gérer →</a>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-gray-600 text-sm font-semibold mb-2">Total Tickets</h3>
            <p class="text-3xl font-bold text-purple-600">{{ stats.total_tickets }}</p>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-gray-600 text-sm font-semibold mb-2">Tickets Ouverts</h3>
            <p class="text-3xl font-bold text-orange-600">{{ stats.open_tickets }}</p>
        </div>

        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-gray-600 text-sm font-semibold mb-2">Notifications</h3>
            <p class="text-3xl font-bold text-red-600">{{ stats.pending_notifications }}</p>
            <a href="{{ path('admin_notifications') }}" class="text-red-600 text-xs hover:underline mt-2 inline-block">Voir →</a>
        </div>
    </div>

    <!-- Navigation -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="{{ path('admin_users') }}" class="bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-lg shadow p-6 hover:shadow-lg transition">
            <h2 class="text-xl font-bold mb-2">👥 Gestion des Utilisateurs</h2>
            <p class="text-sm opacity-90">Créer, éditer, supprimer les utilisateurs du système</p>
        </a>

        <a href="{{ path('admin_services') }}" class="bg-gradient-to-r from-green-500 to-green-600 text-white rounded-lg shadow p-6 hover:shadow-lg transition">
            <h2 class="text-xl font-bold mb-2">⚙️ Gestion des Services</h2>
            <p class="text-sm opacity-90">Configurer les services et délais</p>
        </a>

        <a href="{{ path('admin_notifications') }}" class="bg-gradient-to-r from-red-500 to-red-600 text-white rounded-lg shadow p-6 hover:shadow-lg transition">
            <h2 class="text-xl font-bold mb-2">📬 Journaux de Notifications</h2>
            <p class="text-sm opacity-90">Voir tous les événements de notification</p>
        </a>

        <a href="{{ path('admin_stats') }}" class="bg-gradient-to-r from-purple-500 to-purple-600 text-white rounded-lg shadow p-6 hover:shadow-lg transition">
            <h2 class="text-xl font-bold mb-2">📊 Statistiques</h2>
            <p class="text-sm opacity-90">Analyse des tickets et performances</p>
        </a>
    </div>
</div>
{% endblock %}
