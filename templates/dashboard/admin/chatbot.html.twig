{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<div class="dashboard-home">
    <div class="dashboard-home-toolbar" style="display:flex; justify-content:space-between; align-items:center;">
        <h2 style="margin:0; display:flex; align-items:center; gap:8px;">
            <span style="width:36px; height:36px; border-radius:10px; background:linear-gradient(135deg,#ff7900,#ffa733); display:flex; align-items:center; justify-content:center; font-size:18px;">🤖</span>
            NetBot
        </h2>
        <div style="display:flex; gap:8px;">
            <button onclick="exportFullConversation()" class="nb-btn nb-btn-secondary">📄 Exporter la conversation</button>
            <button onclick="resetConversation()" class="nb-btn nb-btn-danger">🗑️ Nouvelle conversation</button>
        </div>
    </div>

    <div class="card" style="padding:0; overflow:hidden;">
        <div id="chatMessages" style="height:480px; overflow-y:auto; padding:20px; background:#f4f6f9;"></div>

        <div style="border-top:1px solid #e2e8f0; padding:14px; background:#fff; display:flex; gap:10px;">
            <input type="text" id="chatInput" placeholder="Pose ta question à NetBot (FR ou EN)..."
                   style="flex:1; padding:11px 16px; border:1.5px solid #d8dee5; border-radius:10px; font-size:14px; outline:none;"
                   onkeydown="if(event.key==='Enter') sendMessage();">
            <button onclick="sendMessage()" class="nb-btn nb-btn-primary">Envoyer</button>
        </div>
    </div>
</div>

<style>
.nb-btn { border-radius: 8px; padding: 8px 14px; font-size: 12px; font-weight: 600; border: none; cursor: pointer; transition: transform .1s, opacity .15s; }
.nb-btn:hover { opacity: 0.88; }
.nb-btn:active { transform: scale(0.97); }
.nb-btn-primary { background: #ff7900; color: #fff; }
.nb-btn-secondary { background: #eef2f7; color: #334155; border: 1px solid #d8dee5; }
.nb-btn-danger { background: #fff; color: #dc2626; border: 1px solid #fecaca; }
.nb-bubble-user { background: linear-gradient(135deg, #ff7900, #ff9d3d); color: #fff; }
.nb-bubble-bot { background: #ffffff; color: #0f172a; border: 1px solid #e2e8f0; border-left: 3px solid #ff7900; }
.nb-bubble-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
</style>

<script>
let conversationHistory = {{ rawMessagesJson|raw }};
let chatExports = {{ rawExportsJson|raw }};

function appendBubble(role, text, isError = false) {
    const container = document.getElementById('chatMessages');
    const bubble = document.createElement('div');
    bubble.style.marginBottom = '14px';
    bubble.style.display = 'flex';
    bubble.style.justifyContent = role === 'user' ? 'flex-end' : 'flex-start';

    const inner = document.createElement('div');
    inner.style.maxWidth = '75%';
    inner.style.padding = '12px 16px';
    inner.style.borderRadius = '14px';
    inner.style.whiteSpace = 'pre-wrap';
    inner.style.fontSize = '14px';
    inner.style.lineHeight = '1.55';
    inner.style.boxShadow = '0 1px 2px rgba(0,0,0,0.06)';
    inner.className = role === 'user' ? 'nb-bubble-user' : (isError ? 'nb-bubble-error' : 'nb-bubble-bot');

    inner.textContent = text;
    bubble.appendChild(inner);
    container.appendChild(bubble);
    return bubble;
}

function appendExportButtons(index) {
    const container = document.getElementById('chatMessages');
    const wrap = document.createElement('div');
    wrap.style.margin = '2px 0 20px 0';
    wrap.innerHTML = `<button onclick="exportReport(${index})" class="nb-btn nb-btn-secondary" style="font-size:11px; padding:5px 10px;">📄 Exporter ce message</button>`;
    container.appendChild(wrap);
}

function renderAllMessages() {
    const container = document.getElementById('chatMessages');
    container.innerHTML = '';
    chatExports.forEach((exp, idx) => {
        appendBubble('user', exp.question);
        appendBubble('assistant', exp.answer);
        appendExportButtons(idx);
    });
    container.scrollTop = container.scrollHeight;
}

async function sendMessage() {
    const input = document.getElementById('chatInput');
    const question = input.value.trim();
    if (!question) return;

    appendBubble('user', question);
    input.value = '';
    document.getElementById('chatMessages').scrollTop = 999999;
    const loadingBubble = appendBubble('assistant', '⏳ NetBot réfléchit...');

    try {
        const response = await fetch('{{ path('admin_chatbot_ask') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question: question, history: conversationHistory }),
        });
        const data = await response.json();
        loadingBubble.remove();

        if (data.error) {
            appendBubble('assistant', '❌ ' + data.error, true);
            return;
        }

        appendBubble('assistant', data.answer);
        conversationHistory = data.messages;

        const newIndex = chatExports.length;
        chatExports.push({ question: question, answer: data.answer, raw_data: data.raw_data });
        appendExportButtons(newIndex);

        document.getElementById('chatMessages').scrollTop = 999999;
    } catch (e) {
        loadingBubble.remove();
        appendBubble('assistant', '❌ Erreur de connexion au serveur.', true);
    }
}

async function exportReport(index) {
    const exp = chatExports[index];
    if (!exp) return;
    const response = await fetch('{{ path('admin_chatbot_export_pdf') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(exp),
    });
    if (!response.ok) { alert('Erreur export.'); return; }
    const blob = await response.blob();
    const link = document.createElement('a');
    link.href = window.URL.createObjectURL(blob);
    link.download = `rapport_netbot_${index}.pdf`;
    link.click();
}

async function exportFullConversation() {
    if (chatExports.length === 0) { alert('Aucun échange à exporter.'); return; }
    const response = await fetch('{{ path('admin_chatbot_export_full_pdf') }}', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ exports: chatExports }),
    });
    if (!response.ok) { alert('Erreur export.'); return; }
    const blob = await response.blob();
    const link = document.createElement('a');
    link.href = window.URL.createObjectURL(blob);
    link.download = 'conversation_netbot.pdf';
    link.click();
}

async function resetConversation() {
    if (!confirm('Effacer toute la conversation avec NetBot ?')) return;
    await fetch('{{ path('admin_chatbot_reset') }}', { method: 'POST' });
    conversationHistory = [];
    chatExports = [];
    document.getElementById('chatMessages').innerHTML = '';
}

renderAllMessages();
</script>
{% endblock %}