{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<div class="workflow-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">Alertes</h2>
            <div class="page-desc">Sites critiques nécessitant une attention</div>
        </div>
    </div>

    <div class="card">
        {% if criticalSites is empty %}
            <div class="empty-state">✅ Aucune alerte critique</div>
        {% else %}
            <table class="workflow-table">
                <thead>
                    <tr>
                        <th>Site</th>
                        <th>Service</th>
                        <th>Classification</th>
                        <th>Occurrences</th>
                        <th>Date max</th>
                    </tr>
                </thead>
                <tbody>
                    {% for site in criticalSites %}
                        <tr>
                            <td>{{ site.siteName }}</td>
                            <td>{{ site.serviceName }}</td>
                            <td>{{ site.classification }}</td>
                            <td>{{ site.nombreOccurrences }}</td>
                            <td>{{ site.dateMax|date('d/m/Y H:i') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
{% endblock %}