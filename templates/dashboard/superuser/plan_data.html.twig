{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
.plan-data-page { padding-bottom: 40px; }
.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
.page-title { font-size: 28px; font-weight: 700; color: #07152f; margin: 0; }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
.stat-card { background: white; border-radius: 16px; padding: 20px; border: 1px solid #e2e8f0; }
.stat-value { font-size: 32px; font-weight: 800; color: #1e293b; }
.stat-label { color: #64748b; font-size: 14px; }
.btn-primary { background: #3b82f6; color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; }
</style>

<div class="plan-data-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">Plan Data - Analyse IA</h2>
            <div class="page-desc">Analyse des sites critiques et recommandations d'actions</div>
        </div>
        <div>
            <a href="{{ path('superuser_ia_recommendations') }}" class="btn-primary">🤖 Voir recommandations IA →</a>
        </div>
    </div>

    <!-- Statistiques globales -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Sites critiques</div>
            <div class="stat-value">{{ criticalSites|length }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Sites totaux</div>
            <div class="stat-value">{{ allSites|length }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Recommandations IA</div>
            <div class="stat-value">{{ recommendations|length }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Actions recommandées</div>
            <div class="stat-value">{{ globalStats.total ?? 0 }}</div>
        </div>
    </div>

    <div class="card">
        <h3 class="panel-title">Sites critiques détectés</h3>
        <div class="table-responsive">
            <table class="workflow-table">
                <thead>
                    <tr>
                        <th>Site</th>
                        <th>Service</th>
                        <th>Classification</th>
                        <th>Trafic Max</th>
                        <th>Occurrences</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for site in criticalSites|slice(0, 20) %}
                        <tr>
                            <td>{{ site.siteName }}</strong></td>
                            <td>{{ site.service ?? '-' }}</span></td>
                            <td>{{ site.classification ?? '-' }}</span></td>
                            <td>{{ site.maxTrafic|number_format(2) }} Mbps</span></td>
                            <td>{{ site.nombreOccurrences }}</span></td>
                            <td>
                                {% if site.isCritical %}
                                    <span class="badge red">Critique</span>
                                {% else %}
                                    <span class="badge orange">À surveiller</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="empty-state">Aucun site critique</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}