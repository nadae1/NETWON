{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    .plan-data-page { padding-bottom: 40px; }
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .page-title { font-size: 28px; font-weight: 700; color: #07152f; margin: 0; }
    .page-desc { color: #60708a; margin-top: 6px; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
    .stat-card { background: white; border-radius: 16px; padding: 20px; border-left: 4px solid; }
    .stat-critical { border-left-color: #dc2626; }
    .stat-secure { border-left-color: #10b981; }
    .stat-warning { border-left-color: #f59e0b; }
    .stat-total { border-left-color: #3b82f6; }
    .stat-value { font-size: 28px; font-weight: 800; }
    .stat-label { color: #64748b; font-size: 14px; }
    .filters-form { display: flex; gap: 15px; margin-bottom: 20px; align-items: flex-end; flex-wrap: wrap; }
    .filter-group { display: flex; flex-direction: column; gap: 6px; }
    .filter-group label { font-size: 12px; font-weight: 600; color: #64748b; }
    .filter-group input, .filter-group select { padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; min-width: 150px; }
    .btn-primary { background: #3b82f6; color: white; padding: 8px 20px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn-outline { background: white; border: 1px solid #cbd5e1; padding: 8px 20px; border-radius: 8px; cursor: pointer; text-decoration: none; color: #475569; }
    .table-responsive { overflow-x: auto; }
    .site-table { width: 100%; border-collapse: collapse; }
    .site-table th, .site-table td { padding: 12px; text-align: left; border-bottom: 1px solid #e2e8f0; }
    .site-table th { background: #f8fafc; font-weight: 600; }
    .site-table tr:hover { background: #f9fafb; cursor: pointer; }
    .badge { padding: 4px 8px; border-radius: 20px; font-size: 11px; font-weight: 600; }
    .badge-critical { background: #fee2e2; color: #dc2626; }
    .badge-secure { background: #dcfce7; color: #16a34a; }
    .badge-warning { background: #fef3c7; color: #d97706; }
    .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); }
    .modal-content { background: white; margin: 5% auto; padding: 20px; width: 80%; max-width: 800px; border-radius: 16px; }
    .close { float: right; font-size: 28px; cursor: pointer; }
    .site-detail { margin-top: 20px; }
    .charts-row { display: flex; gap: 20px; margin-top: 20px; flex-wrap: wrap; }
    .chart-container { flex: 1; min-width: 250px; height: 300px; }
    #modalMap { height: 300px; width: 100%; border-radius: 12px; margin-top: 20px; }
    .pagination { margin-top: 20px; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
    .page-link { padding: 6px 12px; border: 1px solid #cbd5e1; border-radius: 6px; text-decoration: none; color: #3b82f6; }
    .page-link.active { background: #3b82f6; color: white; }
    .alert { background: #fef3c7; border-left: 4px solid #f59e0b; padding: 15px; margin-bottom: 20px; border-radius: 8px; }
</style>

<div class="plan-data-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">Plan Data - Analyse IA</h2>
            <div class="page-desc">Analyse des sites, visualisation cartographique et KPIs</div>
        </div>
        <div>
            <a href="{{ path('superuser_ia_recommendations') }}" class="btn-primary">🤖 Voir recommandations IA</a>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="stats-grid">
        <div class="stat-card stat-total">
            <div class="stat-value">{{ totalSites }}</div>
            <div class="stat-label">Total Sites</div>
        </div>
        <div class="stat-card stat-critical">
            <div class="stat-value">{{ criticalSites }}</div>
            <div class="stat-label">Sites Critiques</div>
        </div>
        <div class="stat-card stat-secure">
            <div class="stat-value">{{ secureSites }}</div>
            <div class="stat-label">Sites Sécurisés</div>
        </div>
        <div class="stat-card stat-warning">
            <div class="stat-value">{{ warningSites }}</div>
            <div class="stat-label">Sites Sous Observation</div>
        </div>
    </div>

    <!-- Filtres -->
    <form method="get" class="filters-form">
        <div class="filter-group">
            <label>Service</label>
            <select name="service">
                <option value="">Tous</option>
                {% for service in services %}
                    <option value="{{ service }}" {% if currentService == service %}selected{% endif %}>{{ service }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="filter-group">
            <label>Recherche</label>
            <input type="text" name="search" value="{{ currentSearch }}" placeholder="Nom du site...">
        </div>
        <button type="submit" class="btn-primary">Filtrer</button>
        <a href="{{ path('superuser_plan_data') }}" class="btn-outline">Réinitialiser</a>
    </form>

    {% if importNeeded %}
        <div class="alert">
            Aucune donnée trouvée. Veuillez effectuer un import.
            <a href="{{ path('superuser_dashboard_import') }}" class="btn-primary" style="margin-left: 10px;">Importer</a>
        </div>
    {% endif %}

    <!-- Tableau des sites -->
    <div class="card">
        <div class="table-responsive">
            <table class="site-table">
                <thead>
                    <tr>
                        <th>Site</th>
                        <th>Service</th>
                        <th>Classification</th>
                        <th>Type Trans</th>
                        <th>Max Trafic (Mbps)</th>
                        <th>Capacité (Mbps)</th>
                        <th>Occurrences</th>
                        <th>Taux Utilisation</th>
                        <th>État</th>
                    </tr>
                </thead>
                <tbody>
                    {% for site in sites %}
{% set utilisation = (site.capaciteMbps > 0) ? ((site.maxTrafic / site.capaciteMbps * 100)|round(1)) : 0 %}                        <tr class="site-row" data-site-id="{{ site.id }}" data-site-name="{{ site.siteName }}" data-lat="{{ site.latitude }}" data-lng="{{ site.longitude }}" data-max-trafic="{{ site.maxTrafic }}" data-capacite="{{ site.capaciteMbps }}" data-utilisation="{{ utilisation }}">
                            <td><strong>{{ site.siteName }}</strong></td>
                            <td>{{ site.service }}</td>
                            <td>{{ site.classification }}</td>
                            <td>{{ site.typeTrans }}</td>
                            <td>{{ site.maxTrafic|number_format(2, '.', ' ') }}</td>
                            <td>{{ site.capaciteMbps ? site.capaciteMbps|number_format(2, '.', ' ') : '-' }}</td>                            <td>{{ site.nombreOccurrences }}</td>
                            <td>{{ utilisation > 0 ? utilisation ~ '%' : '-' }}</td>
                            <td>
                                {% if site.isCritical %}
                                    <span class="badge badge-critical">Critique</span>
                                {% elseif utilisation > 80 %}
                                    <span class="badge badge-warning">Sous observation</span>
                                {% else %}
                                    <span class="badge badge-secure">Sécurisé</span>
                                {% endif %}
                             </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9" class="empty-state">Aucun site trouvé</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        {% if pagination.totalPages > 1 %}
            <div class="pagination">
                {% for p in 1..pagination.totalPages %}
                    <a href="{{ path('superuser_plan_data', {page: p, service: currentService, search: currentSearch}) }}" class="page-link {{ p == pagination.page ? 'active' : '' }}">{{ p }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<!-- Modal pour les détails du site -->
<div id="siteModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h3 id="modalSiteName"></h3>
        <div class="site-detail">
            <div class="charts-row">
                <div class="chart-container">
                    <canvas id="trafficChart"></canvas>
                </div>
                <div class="chart-container">
                    <canvas id="capacityChart"></canvas>
                </div>
            </div>
            <div id="modalMap" style="height: 300px; margin-top: 20px;"></div>
        </div>
    </div>
</div>

<script>
    let currentChart = null;
    let capacityChart = null;
    let modalMap = null;

    function loadSiteDetails(siteId, siteName, lat, lng, maxTrafic, capacite, utilisation) {
        document.getElementById('modalSiteName').innerText = siteName;

        // Simuler des données de trafic sur 24h (pour démonstration)
        const hours = Array.from({length: 24}, (_, i) => i + 'h');
        const trafficData = Array.from({length: 24}, (_, i) => {
            let peak = 20;
            let val = maxTrafic * (0.3 + 0.7 * Math.sin(Math.PI * (i - peak) / 12));
            return Math.round(val * 10) / 10;
        });

        if (currentChart) currentChart.destroy();
        if (capacityChart) capacityChart.destroy();

        const ctxTraffic = document.getElementById('trafficChart').getContext('2d');
        currentChart = new Chart(ctxTraffic, {
            type: 'line',
            data: {
                labels: hours,
                datasets: [{
                    label: 'Trafic (Mbps)',
                    data: trafficData,
                    borderColor: '#ef4444',
                    fill: false
                }]
            },
            options: { responsive: true, maintainAspectRatio: true }
        });

        const ctxCapacity = document.getElementById('capacityChart').getContext('2d');
        capacityChart = new Chart(ctxCapacity, {
            type: 'bar',
            data: {
                labels: ['Trafic max', 'Capacité'],
                datasets: [{
                    label: 'Mbps',
                    data: [maxTrafic, capacite],
                    backgroundColor: ['#3b82f6', '#10b981']
                }]
            },
            options: { responsive: true, maintainAspectRatio: true }
        });

        // Carte
        if (modalMap) modalMap.remove();
        modalMap = L.map('modalMap').setView([lat || 34.5, lng || 9.5], lat ? 10 : 7);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a>'
        }).addTo(modalMap);
        if (lat && lng) {
            L.marker([lat, lng]).addTo(modalMap).bindPopup(siteName).openPopup();
        }
    }

    // Gestion du modal
    const modal = document.getElementById('siteModal');
    const span = document.getElementsByClassName('close')[0];
    span.onclick = function() { modal.style.display = 'none'; };
    window.onclick = function(event) { if (event.target == modal) modal.style.display = 'none'; };

    document.querySelectorAll('.site-row').forEach(row => {
        row.addEventListener('click', () => {
            const siteId = row.dataset.siteId;
            const siteName = row.dataset.siteName;
            const lat = parseFloat(row.dataset.lat) || null;
            const lng = parseFloat(row.dataset.lng) || null;
            const maxTrafic = parseFloat(row.dataset.maxTrafic);
            const capacite = parseFloat(row.dataset.capacite);
            const utilisation = parseFloat(row.dataset.utilisation);
            loadSiteDetails(siteId, siteName, lat, lng, maxTrafic, capacite, utilisation);
            modal.style.display = 'block';
        });
    });

    // Popup d'import si aucun site
    {% if importNeeded %}
        window.addEventListener('DOMContentLoaded', () => {
            if (confirm('Aucune donnée trouvée. Voulez-vous importer des fichiers ?')) {
                window.location.href = "{{ path('superuser_dashboard_import') }}";
            }
        });
    {% endif %}
</script>
{% endblock %}