{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
.kpis-page { padding-bottom: 40px; }
.page-header { margin-bottom: 30px; }
.page-title { font-size: 28px; font-weight: 700; color: #07152f; }
.page-desc { color: #60708a; margin-top: 5px; }
.filter-form { margin-bottom: 30px; display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap; }
.filter-group { display: flex; flex-direction: column; gap: 6px; }
.filter-group label { font-size: 12px; font-weight: 600; color: #64748b; }
.filter-group select, .filter-group input { padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; min-width: 150px; }
.btn-filter { background: #3b82f6; color: white; border: none; padding: 8px 20px; border-radius: 8px; cursor: pointer; }
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 40px; }
.stat-card { background: white; border-radius: 16px; padding: 20px; border: 1px solid #e2e8f0; }
.stat-value { font-size: 32px; font-weight: 800; color: #1e293b; }
.stat-label { color: #64748b; font-size: 14px; margin-top: 5px; }
.chart-card { background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 20px; margin-top: 20px; }
.chart-title { font-size: 18px; font-weight: 700; margin-bottom: 20px; }
.chart-container { height: 400px; }
</style>

<div class="kpis-page">
    <div class="page-header">
        <h2 class="page-title">KPIs</h2>
        <div class="page-desc">Indicateurs clés de performance</div>
    </div>

    <!-- Filtre -->
    <form method="get" class="filter-form">
        <div class="filter-group">
            <label>Service</label>
            <select name="service">
                <option value="all" {% if currentService == 'all' %}selected{% endif %}>Tous</option>
                <option value="FO" {% if currentService == 'FO' %}selected{% endif %}>FO</option>
                <option value="FH" {% if currentService == 'FH' %}selected{% endif %}>FH</option>
                <option value="SHARED" {% if currentService == 'SHARED' %}selected{% endif %}>SHARED</option>
            </select>
        </div>
        <button type="submit" class="btn-filter">Filtrer</button>
    </form>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value">{{ totalSites }}</div>
            <div class="stat-label">Total Sites</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">{{ criticalSites }}</div>
            <div class="stat-label">Sites Critiques ({{ criticalPercentage }}%)</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">{{ avgTraffic }}</div>
            <div class="stat-label">Trafic Moyen (Mbps)</div>
        </div>
    </div>

    <div class="chart-card">
        <div class="chart-title">Top 20 trafic des sites (Mbps)</div>
        <div class="chart-container">
            <canvas id="trafficChart"></canvas>
        </div>
    </div>

    <!-- Tableau distribution par service (optionnel, gardé) -->
    <div class="chart-card" style="margin-top: 20px;">
        <div class="chart-title">Distribution par service</div>
        <table style="width:100%; border-collapse: collapse;">
            <thead>
                <tr><th style="text-align:left; padding:8px;">Service</th><th style="text-align:left; padding:8px;">Nombre de sites</th></tr>
            </thead>
            <tbody>
                <tr><td style="padding:8px;">FO</td><td style="padding:8px;">{{ serviceDistribution.FO|default(0) }}</td></tr>
                <tr><td style="padding:8px;">FH</td><td style="padding:8px;">{{ serviceDistribution.FH|default(0) }}</td></tr>
                <tr><td style="padding:8px;">SHARED</td><td style="padding:8px;">{{ serviceDistribution.SHARED|default(0) }}</td></tr>
                <tr><td style="padding:8px;">BACKBONE</td><td style="padding:8px;">0</td></tr>
            </tbody>
        </table>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('trafficChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: {{ siteNames|json_encode|raw }},
            datasets: [{
                label: 'Trafic max (Mbps)',
                data: {{ trafficValues|json_encode|raw }},
                backgroundColor: '#3b82f6',
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                tooltip: { callbacks: { label: (ctx) => `${ctx.raw} Mbps` } },
                legend: { position: 'top' }
            },
            scales: {
                y: { title: { display: true, text: 'Mbps' }, beginAtZero: true },
                x: { ticks: { autoSkip: true, maxTicksLimit: 15 } }
            }
        }
    });
});
</script>
{% endblock %}