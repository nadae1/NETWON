{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
.superuser-dashboard { padding-bottom: 40px; }
.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
.page-title { font-size: 28px; font-weight: 700; color: #07152f; margin: 0; }
.page-desc { color: #60708a; font-size: 15px; margin-top: 6px; }

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

.stat-card {
    border-radius: 16px;
    padding: 24px;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    border-top: 4px solid #ff7900;
}

.stat-blue { background: #eff6ff; border-color: #bfdbfe; border-top-color: #ff7900; }
.stat-red { background: #fff1f2; border-color: #fecaca; border-top-color: #ff7900; }
.stat-green { background: #ecfeff; border-color: #99f6e4; border-top-color: #ff7900; }
.stat-orange { background: #fffbeb; border-color: #fed7aa; border-top-color: #ff7900; }

.stat-label { font-size: 13px; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; }
.stat-value { font-size: 36px; font-weight: 800; color: #020617; line-height: 1.2; margin-top: 8px; }
.stat-small { color: #536782; font-size: 13px; margin-top: 6px; }
.stat-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 22px; }

.icon-blue { background: #bfdbfe; color: #2563eb; }
.icon-red { background: #fecaca; color: #ef4444; }
.icon-green { background: #ccfbf1; color: #14b8a6; }
.icon-orange { background: #fde68a; color: #d97706; }

.service-tabs { display: flex; gap: 10px; margin-bottom: 30px; flex-wrap: wrap; }
.service-tab {
    padding: 10px 24px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    background: #f1f5f9;
    color: #475569;
}
.service-tab.active { background: #3b82f6; color: white; }

.charts-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 28px;
    margin-top: 30px;
}

.chart-card {
    background: white;
    border: 1px solid #dbe3ef;
    border-radius: 18px;
    padding: 28px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.chart-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 24px;
    color: #020617;
}

.chart-box {
    height: 360px;
    position: relative;
}

.legend {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 28px;
    flex-wrap: wrap;
}

.legend-item { display: flex; align-items: center; gap: 8px; font-size: 14px; }
.legend-dot { width: 12px; height: 12px; border-radius: 50%; }
.dot-blue { background: #3b82f6; }
.dot-green { background: #14b8a6; }
.dot-purple { background: #8b5cf6; }

.btn-primary {
    background: #3b82f6;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
}
.btn-secondary {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    color: #475569;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
}

/* Nouveau style pour la carte */
.map-section {
    margin-top: 40px;
}
.map-card {
    background: white;
    border: 1px solid #dbe3ef;
    border-radius: 18px;
    padding: 20px;
}
.map-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 15px;
}
.map-filters {
    display: flex;
    gap: 8px;
}
.map-filter-btn {
    background: #f1f5f9;
    border: none;
    padding: 6px 16px;
    border-radius: 20px;
    cursor: pointer;
    font-weight: 500;
}
.map-filter-btn.active {
    background: #3b82f6;
    color: white;
}
#import-gps-form {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
}
#import-gps-form input[type="file"] {
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 12px;
}
.import-message {
    margin-top: 8px;
    font-size: 12px;
    color: #64748b;
}
#map {
    height: 500px;
    width: 100%;
    border-radius: 12px;
    z-index: 1;
}
@media (max-width: 1100px) {
    .stats-grid, .charts-grid { grid-template-columns: 1fr; }
}
</style>

<div class="superuser-dashboard">
    <div class="page-header">
        <div>
            <h2 class="page-title">SuperUser Dashboard</h2>
            <div class="page-desc">Vue globale de tous les sites classés par type trans</div>
        </div>
        <div>
            <a href="{{ path('superuser_dashboard_import') }}" class="btn-primary">+ Nouvel Import</a>
            <a href="{{ path('superuser_data_export_sites') }}" class="btn-secondary" style="margin-left: 10px;">📥 Export</a>
        </div>
    </div>

    <div class="service-tabs">
        <a href="{{ path('superuser_dashboard_home') }}" class="service-tab active">Tous</a>
        <a href="{{ path('superuser_dashboard_sites', {service: 'FO'}) }}" class="service-tab">📡 FO ({{ serviceDistribution.FO|default(0) }})</a>
        <a href="{{ path('superuser_dashboard_sites', {service: 'FH'}) }}" class="service-tab">📡 FH ({{ serviceDistribution.FH|default(0) }})</a>
        <a href="{{ path('superuser_dashboard_sites', {service: 'SHARED'}) }}" class="service-tab">🔄 SHARED ({{ serviceDistribution.SHARED|default(0) }})</a>
    </div>

    <div class="stats-grid">
        <div class="stat-card stat-blue">
            <div>
                <div class="stat-label">Total Sites</div>
                <div class="stat-value">{{ totalSites }}</div>
                <div class="stat-small">
                    {{ serviceDistribution.FO|default(0) }} FO •
                    {{ serviceDistribution.FH|default(0) }} FH •
                    {{ serviceDistribution.SHARED|default(0) }} SHARED
                </div>
            </div>
            <div class="stat-icon icon-blue">📡</div>
        </div>

        <div class="stat-card stat-red">
            <div>
                <div class="stat-label">Sites Critiques</div>
                <div class="stat-value">{{ criticalSites }}</div>
                <div class="stat-small">{{ criticalPercentage }}% du total</div>
            </div>
            <div class="stat-icon icon-red">⚠️</div>
        </div>

        <div class="stat-card stat-green">
            <div>
                <div class="stat-label">Trafic Moyen</div>
                <div class="stat-value">{{ avgTraffic }}</div>
                <div class="stat-small">Mbps</div>
            </div>
            <div class="stat-icon icon-green">📊</div>
        </div>

        <div class="stat-card stat-orange">
            <div>
                <div class="stat-label">Services Actifs</div>
                <div class="stat-value">3</div>
                <div class="stat-small">FO / FH / SHARED</div>
            </div>
            <div class="stat-icon icon-orange">🏷️</div>
        </div>
    </div>

    <div class="charts-grid">
        <div class="chart-card">
            <div class="chart-title">Classification des sites</div>
            <div class="chart-box">
                <canvas id="classificationChart"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-title">Distribution par service</div>
            <div class="chart-box">
                <canvas id="serviceDonut"></canvas>
            </div>

            <div class="legend">
                <div class="legend-item"><span class="legend-dot dot-blue"></span> FO ({{ serviceDistribution.FO|default(0) }})</div>
                <div class="legend-item"><span class="legend-dot dot-green"></span> FH ({{ serviceDistribution.FH|default(0) }})</div>
                <div class="legend-item"><span class="legend-dot dot-purple"></span> SHARED ({{ serviceDistribution.SHARED|default(0) }})</div>
            </div>
        </div>
    </div>

    <!-- SECTION CARTE -->
    <div class="map-section">
        <div class="map-card">
            <div class="map-header">
                <h3 class="chart-title" style="margin-bottom:0;">🗺️ Carte des sites</h3>
                <div class="map-filters">
                    <button class="map-filter-btn active" data-filter="all">Tous</button>
                    <button class="map-filter-btn" data-filter="FO">FO</button>
                    <button class="map-filter-btn" data-filter="FH">FH</button>
                    <button class="map-filter-btn" data-filter="SHARED">SHARED</button>
                </div>
            </div>
            <div class="import-section" style="margin-bottom:15px;">
                <form method="post" action="{{ path('superuser_map_import') }}" enctype="multipart/form-data" id="import-gps-form">
                    <input type="file" name="gps_file" accept=".xlsx,.xls,.csv" required>
                    <button type="submit" class="btn-secondary">📂 Importer coordonnées GPS</button>
                </form>
                <div class="import-message">Fichier Excel ou CSV avec colonnes : site (nom du site), latitude, longitude</div>
            </div>
            <div id="map"></div>
            <div class="legend" style="margin-top: 12px;">
                <div class="legend-item"><span class="legend-dot" style="background:#dc2626;"></span> Critique (rouge)</div>
                <div class="legend-item"><span class="legend-dot" style="background:#f59e0b;"></span> Sous observation (jaune)</div>
                <div class="legend-item"><span class="legend-dot" style="background:#10b981;"></span> Sécurisé (vert)</div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const classificationStats = {{ classificationStats|json_encode|raw }};
    const serviceDistribution = {{ serviceDistribution|json_encode|raw }};

    // Graphique classification (inchangé)
    const wantedClasses = ['TF', 'COTRANS', 'NO_COTRANS', 'NON_TDD'];
    const labels = wantedClasses;
    const totalData = labels.map(label => classificationStats[label]?.total || 0);
    const criticalData = labels.map(label => classificationStats[label]?.critical || 0);

    new Chart(document.getElementById('classificationChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [
                { label: 'Total', data: totalData, backgroundColor: '#3b82f6', borderRadius: 6 },
                { label: 'Critique', data: criticalData, backgroundColor: '#ef4444', borderRadius: 6 }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { tooltip: { backgroundColor: '#fff', titleColor: '#020617', bodyColor: '#2563eb' }, legend: { position: 'bottom' } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'Nombre de sites' } } }
        }
    });

    new Chart(document.getElementById('serviceDonut'), {
        type: 'doughnut',
        data: {
            labels: ['FO', 'FH', 'SHARED'],
            datasets: [{
                data: [serviceDistribution.FO || 0, serviceDistribution.FH || 0, serviceDistribution.SHARED || 0],
                backgroundColor: ['#3b82f6', '#14b8a6', '#8b5cf6'],
                borderWidth: 4,
                hoverOffset: 8
            }]
        },
        options: { responsive: true, maintainAspectRatio: false, cutout: '55%', plugins: { legend: { display: false } } }
    });

    // ==================== CARTE ====================
    let map = L.map('map').setView([34.5, 9.5], 7); // Centre Tunisie
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> & CartoDB'
    }).addTo(map);

    let currentLayer = null;
    let currentFilter = 'all';

    function loadMapData(filter) {
        fetch(`{{ path('superuser_map_data') }}?filter=${filter}`)
            .then(response => response.json())
            .then(data => {
                if (currentLayer) map.removeLayer(currentLayer);
                const markers = L.geoJSON(data, {
                    pointToLayer: function(feature, latlng) {
                        const color = feature.properties.color;
                        const fillColor = color === 'red' ? '#dc2626' : (color === 'yellow' ? '#f59e0b' : '#10b981');
                        return L.circleMarker(latlng, {
                            radius: 8,
                            fillColor: fillColor,
                            color: '#fff',
                            weight: 1,
                            opacity: 1,
                            fillOpacity: 0.8
                        });
                    },
                    onEachFeature: function(feature, layer) {
                        const p = feature.properties;
                        layer.bindPopup(`
                            <strong>${p.name}</strong><br>
                            Service: ${p.service}<br>
                            Statut: ${p.status}<br>
                            Trafic: ${p.traffic} Mbps
                        `);
                    }
                });
                markers.addTo(map);
                currentLayer = markers;
            })
            .catch(err => console.error('Erreur chargement carte:', err));
    }

    // Filtres carte
    document.querySelectorAll('.map-filter-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.map-filter-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentFilter = this.dataset.filter;
            loadMapData(currentFilter);
        });
    });

    // Chargement initial
    loadMapData('all');
});
</script>
{% endblock %}