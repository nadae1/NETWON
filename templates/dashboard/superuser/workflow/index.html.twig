{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
.workflow-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 20px;
    margin-top: 20px;
}
.workflow-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px;
    transition: all 0.2s;
}
.workflow-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
}
.workflow-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    flex-wrap: wrap;
}
.workflow-id {
    font-weight: 700;
    color: #3b82f6;
}
.badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
}
.badge-open { background: #dbeafe; color: #2563eb; }
.badge-in_progress { background: #fef3c7; color: #d97706; }
.badge-blocked { background: #fee2e2; color: #dc2626; }
.badge-completed { background: #dcfce7; color: #16a34a; }
.badge-closed { background: #e2e8f0; color: #475569; }
.progress-bar {
    background: #e2e8f0;
    border-radius: 10px;
    height: 8px;
    overflow: hidden;
    margin: 10px 0;
}
.progress-fill {
    background: #3b82f6;
    height: 100%;
    border-radius: 10px;
    transition: width 0.3s;
}
</style>

<div class="workflow-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">Workflows</h2>
            <div class="page-desc">Gestion des workflows créés par le Superuser</div>
        </div>
        <div>
            <a href="{{ path('superuser_workflow_new') }}" class="btn-primary">+ Nouveau workflow</a>
            <a href="{{ path('superuser_plan_data') }}" class="btn-secondary" style="margin-left: 10px;">🤖 Plan Data IA</a>
        </div>
    </div>

    <!-- Filtre par statut -->
    <div class="service-tabs">
        <a href="{{ path('superuser_workflow_index') }}" class="service-tab {% if not currentStatus %}active{% endif %}">Tous</a>
        <a href="{{ path('superuser_workflow_index', {status: 'open'}) }}" class="service-tab {% if currentStatus == 'open' %}active{% endif %}">Ouverts</a>
        <a href="{{ path('superuser_workflow_index', {status: 'in_progress'}) }}" class="service-tab {% if currentStatus == 'in_progress' %}active{% endif %}">En cours</a>
        <a href="{{ path('superuser_workflow_index', {status: 'blocked'}) }}" class="service-tab {% if currentStatus == 'blocked' %}active{% endif %}">Bloqués</a>
        <a href="{{ path('superuser_workflow_index', {status: 'completed'}) }}" class="service-tab {% if currentStatus == 'completed' %}active{% endif %}">Terminés</a>
    </div>

    {% if tickets is empty %}
        <div class="card">
            <div class="empty-state">Aucun workflow trouvé.</div>
        </div>
    {% else %}
        <div class="workflow-grid">
            {% for ticket in tickets %}
                {% set blocker = ticket.blockerInfo ?? null %}
                <div class="workflow-card">
                    <div class="workflow-header">
                        <span class="workflow-id">#{{ ticket.id }}</span>
                        <span class="badge badge-{{ ticket.status|replace({'_': '-'}) }}">{{ ticket.status|replace({'_': ' '})|upper }}</span>
                    </div>
                    
                    <h3 style="margin: 0 0 8px 0; font-size: 18px;">{{ ticket.title }}</h3>
                    <p style="color: #64748b; font-size: 13px; margin-bottom: 12px;">{{ ticket.description|slice(0, 100) }}{% if ticket.description|length > 100 %}...{% endif %}</p>
                    
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: {{ ticket.progress }}%"></div>
                    </div>
                    <div style="font-size: 12px; color: #475569; text-align: right;">{{ ticket.progress }}%</div>
                    
                    <div style="margin-top: 12px; display: flex; justify-content: space-between; font-size: 12px; color: #64748b;">
                        <span>📅 {{ ticket.createdAt|date('d/m/Y') }}</span>
                        <span>📋 {{ ticket.tasks|length }} tâches</span>
                        <span>📍 {{ ticket.ticketSites|length }} sites</span>
                    </div>
                    
                    {% if blocker %}
                        <div style="margin-top: 12px; padding: 8px; background: #fee2e2; border-radius: 8px; font-size: 12px;">
                            🚫 Bloqué chez: {{ blocker.user ? blocker.user.username : blocker.service }}
                        </div>
                    {% endif %}
                    
                    <div style="margin-top: 15px;">
                        <a href="{{ path('superuser_workflow_show', {id: ticket.id}) }}" class="btn-outline" style="width: 100%; text-align: center; display: block;">Voir détails →</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}