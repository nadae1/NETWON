{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
.workflow-show {
    padding-bottom: 30px;
}

.workflow-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 24px;
}

.workflow-title {
    font-size: 30px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
}

.workflow-desc {
    margin-top: 6px;
    color: #64748b;
    font-size: 16px;
}

.workflow-actions {
    display: flex;
    gap: 10px;
}

.workflow-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
}

.workflow-card {
    background: #fff;
    border: 1px solid #dbe3ef;
    border-radius: 18px;
    padding: 22px;
    box-shadow: 0 6px 16px rgba(15, 23, 42, .04);
}

.workflow-card h3 {
    margin: 0 0 16px;
    font-size: 19px;
    font-weight: 800;
    color: #0f172a;
}

.table-like {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.table-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    align-items: center;
    padding: 13px 14px;
    background: #f8fafc;
    border-radius: 13px;
    color: #334155;
}

.table-head {
    background: #e2e8f0;
    font-weight: 800;
    color: #0f172a;
}

.badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 6px 11px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
}

.badge.mauve {
    background: #ede9fe;
    color: #7c3aed;
}

.badge.blue {
    background: #dbeafe;
    color: #2563eb;
}

.badge.green {
    background: #ccfbf1;
    color: #059669;
}

.badge.red {
    background: #fee2e2;
    color: #ef4444;
}

.muted {
    color: #64748b;
    font-size: 14px;
    margin-top: 4px;
}

.empty-state {
    padding: 22px;
    border: 1px dashed #cbd5e1;
    border-radius: 14px;
    color: #64748b;
    background: #f8fafc;
}

.workflow-progress {
    width: 100%;
    height: 12px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
}

.workflow-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #3b82f6, #22c55e);
}

@media (max-width: 900px) {
    .table-row {
        grid-template-columns: 1fr;
    }

    .workflow-header {
        flex-direction: column;
    }
}
</style>

<div class="workflow-show">
    <div class="workflow-header">
        <div>
            <h2 class="workflow-title">{{ ticket.title }}</h2>
            <div class="workflow-desc">{{ ticket.description ?: 'Aucune description.' }}</div>
        </div>

        <div class="workflow-actions">
            <a href="{{ path('superuser_workflow_index') }}" class="btn">Retour</a>
        </div>
    </div>

    <div class="workflow-grid">

        {# ===== Informations générales ===== #}
        <div class="workflow-card">
            <h3>Informations générales</h3>
            <div class="table-like">
                <div class="table-row">
                    <div><strong>Action</strong></div>
                    <div>{{ ticket.actionType }}</div>
                    <div><strong>Statut</strong></div>
                    <div>
                        {% if ticket.status == 'open' %}
                            <span class="badge mauve">Ouvert</span>
                        {% elseif ticket.status == 'in_progress' %}
                            <span class="badge blue">En cours</span>
                        {% elseif ticket.status == 'completed' %}
                            <span class="badge green">Terminé</span>
                        {% elseif ticket.status == 'closed' %}
                            <span class="badge green">Clôturé</span>
                        {% else %}
                            <span class="badge red">{{ ticket.status }}</span>
                        {% endif %}
                    </div>
                </div>
                <div class="table-row">
                    <div><strong>Progression</strong></div>
                    <div>
                        <div>{{ ticket.progress }}%</div>
                        <div class="workflow-progress">
                            <div class="workflow-progress-bar" style="width: {{ ticket.progress }}%;"></div>
                        </div>
                    </div>
                    <div><strong>Date limite</strong></div>
                    <div>{{ ticket.deadlineAt ? ticket.deadlineAt|date('d/m/Y H:i') : '-' }}</div>
                </div>
                <div class="table-row">
                    <div><strong>Créé par</strong></div>
                    <div>{{ ticket.createdBy.username ?? ticket.createdBy.email ?? 'Utilisateur' }}</div>
                    <div><strong>Date création</strong></div>
                    <div>{{ ticket.createdAt ? ticket.createdAt|date('d/m/Y H:i') : '-' }}</div>
                </div>
                <div class="table-row">
                    <div><strong>Bloqué chez</strong></div>
                    <div>
                        {% set blocker = null %}
                        {% for task in ticket.tasks %}
                            {% if blocker is null and task.status != 'done' %}
                                {% set blocker = task.assignedTo.username ?? task.assignedTo.email %}
                            {% endif %}
                        {% endfor %}
                        {% if blocker %}
                            <span class="badge red">{{ blocker }}</span>
                        {% else %}
                            <span class="badge green">Aucun blocage</span>
                        {% endif %}
                    </div>
                    <div><strong>Clôturé le</strong></div>
                    <div>{{ ticket.closedAt ? ticket.closedAt|date('d/m/Y H:i') : '-' }}</div>
                </div>
            </div>
        </div>

        {# ===== Sites concernés ===== #}
        <div class="workflow-card">
            <h3>Sites concernés</h3>
            {% if ticket.ticketSites is empty %}
                <div class="empty-state">Aucun site lié.</div>
            {% else %}
                <div class="table-like">
                    <div class="table-row table-head">
                        <div>Site</div>
                        <div>Type Trans</div>
                        <div>Service</div>
                        <div>Info</div>
                    </div>
                    {% for ticketSite in ticket.ticketSites %}
                        <div class="table-row">
                            <div><strong>{{ ticketSite.siteName }}</strong></div>
                            <div>{{ ticketSite.typeTrans ?: '-' }}</div>
                            <div>{{ ticketSite.serviceName ?: '-' }}</div>
                            <div>-</div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# ===== Tâches ===== #}
        <div class="workflow-card">
            <h3>Tâches</h3>
            {% if ticket.tasks is empty %}
                <div class="empty-state">Aucune tâche.</div>
            {% else %}
                <div class="table-like">
                    <div class="table-row table-head">
                        <div>Utilisateur</div>
                        <div>Service / Département</div>
                        <div>Statut</div>
                        <div>Preuve</div>
                    </div>
                    {% for task in ticket.tasks %}
                        <div class="table-row">
                            <div>
                                <strong>{{ task.assignedTo.username ?? task.assignedTo.email }}</strong>
                                <div class="muted">{{ task.title ?: 'Traitement demandé' }}</div>
                                <div class="muted">{{ task.description ?: '-' }}</div>
                            </div>
                            <div>
                                {{ task.serviceName ?: '-' }}
                                <div class="muted">{{ task.departmentName ?: '-' }}</div>
                            </div>
                            <div>
                                {% if task.status == 'pending' %}
                                    <span class="badge mauve">En attente</span>
                                {% elseif task.status == 'in_progress' %}
                                    <span class="badge blue">En cours</span>
                                {% elseif task.status == 'done' %}
                                    <span class="badge green">Terminée</span>
                                {% elseif task.status == 'blocked' %}
                                    <span class="badge red">Bloquée</span>
                                {% else %}
                                    <span class="badge red">{{ task.status }}</span>
                                {% endif %}
                                {% if task.completedAt %}
                                    <div class="muted">{{ task.completedAt|date('d/m/Y H:i') }}</div>
                                {% endif %}
                            </div>
                            <div>
                                {% if task.comment %}
                                    <div>{{ task.comment }}</div>
                                {% else %}
                                    <div>-</div>
                                {% endif %}
                                {% if task.proofFile %}
                                    <a href="{{ asset('uploads/ticket_proofs/' ~ task.proofFile) }}" target="_blank">Voir fichier</a>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# ===== Commentaires (corrigé définitif) ===== #}
        <div class="workflow-card">
            <h3>Commentaires</h3>
            {% if ticket.comments is empty %}
                <div class="empty-state">Aucun commentaire.</div>
            {% else %}
                <div class="table-like">
                    <div class="table-row table-head">
                        <div>Utilisateur</div>
                        <div>Message</div>
                        <div>Pièce jointe</div>
                        <div>Date</div>
                    </div>
                    {% for comment in ticket.comments %}
                        <div class="table-row">
                            <div>
                                <strong>
                                    {{ comment.author|default(comment.user.username|default(comment.user.email|default('Anonyme'))) }}
                                </strong>
                            </div>
                            <div>{{ comment.text|default(comment.message|default('')) }}</div>
                            <div>
                                {% set filePath = comment.file_url|default(comment.filePath|default(null)) %}
                                {% if filePath %}
                                    <a href="{{ asset('uploads/ticket_proofs/' ~ filePath) }}" target="_blank">
                                        Pièce jointe
                                    </a>
                                {% else %}
                                    -
                                {% endif %}
                            </div>
                            <div>
                                {% set date = comment.timestamp|default(comment.createdAt|default(null)) %}
                                {{ date is not null ? (date|date('d/m/Y H:i')) : '-' }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {# ===== Historique ===== #}
        <div class="workflow-card">
            <h3>Historique</h3>
            {% if ticket.history is empty %}
                <div class="empty-state">Aucun historique.</div>
            {% else %}
                <div class="table-like">
                    <div class="table-row table-head">
                        <div>Date</div>
                        <div>Action</div>
                        <div>Détails</div>
                        <div>Utilisateur</div>
                    </div>
                    {% for item in ticket.history %}
                        <div class="table-row">
                            <div>{{ item.createdAt|date('d/m/Y H:i') }}</div>
                            <div>{{ item.action }}</div>
                            <div>{{ item.details ?: '-' }}</div>
                            <div>{{ item.user ? (item.user.username ?? item.user.email) : 'Système' }}</div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

    </div>
</div>
{% endblock %}