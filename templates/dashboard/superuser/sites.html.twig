{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<div class="workflow-page">
    <div class="page-header">
        <div>
            <h2 class="page-title">{{ pageTitle|default('Sites traités') }}</h2>
            <div class="page-desc">Tous les sites après traitement Python</div>
        </div>
        <div>
            <a href="{{ path('superuser_dashboard_import') }}" class="btn-primary">+ Nouvel Import</a>
            <a href="{{ path('user_data_export_sites') }}" class="btn-secondary" style="margin-left: 10px;">📥 Export</a>
        </div>
    </div>

    <!-- Service Filter Tabs -->
    <div class="service-tabs">
        <a href="{{ path('superuser_dashboard_sites', {}) }}" class="service-tab {% if not currentService %}active{% endif %}">Tous</a>
        <a href="{{ path('superuser_dashboard_sites', {service: 'FO'}) }}" class="service-tab {% if currentService == 'FO' %}active{% endif %}">📡 FO</a>
        <a href="{{ path('superuser_dashboard_sites', {service: 'FH'}) }}" class="service-tab {% if currentService == 'FH' %}active{% endif %}">📡 FH</a>
        <a href="{{ path('superuser_dashboard_sites', {service: 'SHARED'}) }}" class="service-tab {% if currentService == 'SHARED' %}active{% endif %}">🔄 SHARED</a>
        <a href="{{ path('superuser_dashboard_sites', {service: 'BACKBONE'}) }}" class="service-tab {% if currentService == 'BACKBONE' %}active{% endif %}">🔗 BACKBONE</a>
    </div>

    <!-- Filters -->
    <div class="card" style="margin-bottom: 20px;">
        <form method="get" class="filters-form">
            <input type="hidden" name="service" value="{{ currentService }}">
            <div class="filter-group">
                <label>Classification</label>
                <select name="classification">
                    <option value="">Toutes</option>
                    {% for class in classifications %}
                        <option value="{{ class }}" {% if currentClassification == class %}selected{% endif %}>{{ class }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-group">
                <label>Recherche</label>
                <input type="text" name="search" value="{{ currentSearch }}" placeholder="Nom du site...">
            </div>
            <div class="filter-group">
                <button type="submit" class="btn-secondary">Filtrer</button>
                <a href="{{ path('superuser_dashboard_sites', {service: currentService}) }}" class="btn-link">Réinitialiser</a>
            </div>
        </form>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="workflow-table">
                <thead>
                    <tr>
                        <th>Site</th>
                        <th>Site pairé</th>
                        <th>Service</th>
                        <th>Classification</th>
                        <th>Type Trans</th>
                        <th>Max Trafic</th>
                        <th>Date Max</th>
                        <th>Occurrences</th>
                        <th>État</th>
                    </tr>
                </thead>
                <tbody>
                    {% for site in sites %}
                        <tr>
                            <td><strong>{{ site.siteName }}</strong></td>
                            <td>{{ site.pairedSiteName ?: '-' }}</td>
                            <td><span class="service-badge">{{ site.serviceName ?: '-' }}</span></td>
                            <td>{{ site.classification ?: '-' }}</td>
                            <td>{{ site.typeTrans ?: '-' }}</td>
                            <td>{{ site.maxTrafic|number_format(2, '.', ' ') }}</td>
                            <td>{{ site.dateMax ? site.dateMax|date('d/m/Y H:i') : '-' }}</td>
                            <td>{{ site.nombreOccurrences }}</td>
                            <td>
                                {% if site.isCritical %}
                                    <span class="badge red">Critique</span>
                                {% else %}
                                    <span class="badge green">Normal</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="empty-state">Aucun site trouvé</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        {% if pagination.totalPages > 1 %}
            <div class="pagination">
                {% for p in 1..pagination.totalPages %}
                    <a href="{{ path('superuser_dashboard_sites', {page: p, service: currentService, classification: currentClassification, search: currentSearch}) }}" 
                       class="page-link {% if p == pagination.page %}active{% endif %}">{{ p }}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<style>
.service-tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 25px;
    flex-wrap: wrap;
}
.service-tab {
    padding: 8px 20px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    background: #f1f5f9;
    color: #475569;
    transition: all 0.2s;
}
.service-tab.active {
    background: #3b82f6;
    color: white;
}
.service-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    background: #e2e8f0;
    color: #475569;
}
.filters-form {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: flex-end;
}
.filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.filter-group label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
}
.filter-group select, .filter-group input {
    padding: 8px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    min-width: 150px;
}
.btn-secondary {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
}
.btn-link {
    padding: 8px 16px;
    color: #64748b;
    text-decoration: none;
}
.pagination {
    margin-top: 20px;
    display: flex;
    gap: 8px;
    justify-content: center;
}
.page-link {
    padding: 6px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    text-decoration: none;
    color: #3b82f6;
}
.page-link.active {
    background: #3b82f6;
    color: white;
    border-color: #3b82f6;
}
.badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}
.badge.red {
    background: #fee2e2;
    color: #dc2626;
}
.badge.green {
    background: #dcfce7;
    color: #16a34a;
}
</style>
{% endblock %}