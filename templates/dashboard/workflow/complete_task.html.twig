{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
.task-container {
    max-width: 900px;
    margin: 0 auto;
}

.task-header-banner {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    color: white;
    padding: 30px;
    border-radius: 12px;
    margin-bottom: 30px;
    box-shadow: 0 4px 15px rgba(59, 130, 244, 0.2);
}

.task-title-main {
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 10px 0;
}

.task-meta-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    margin-top: 20px;
}

.meta-badge {
    background: rgba(255, 255, 255, 0.2);
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
}

.meta-label {
    display: block;
    font-size: 12px;
    opacity: 0.9;
    margin-bottom: 4px;
}

.meta-value {
    font-weight: 600;
    font-size: 16px;
}

.task-details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 30px;
}

.task-section {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
}

.section-title {
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 15px;
    font-size: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.info-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #f1f5f9;
    font-size: 14px;
}

.info-row:last-child {
    border-bottom: none;
}

.info-label {
    color: #64748b;
    font-weight: 500;
}

.info-value {
    color: #0f172a;
    font-weight: 600;
}

.form-section {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 30px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group:last-child {
    margin-bottom: 0;
}

.form-label {
    display: block;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 8px;
    font-size: 14px;
}

.form-control,
select,
textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
}

.form-control:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 244, 0.1);
}

textarea {
    resize: vertical;
    min-height: 120px;
}

.button-group {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    margin-top: 30px;
}

.btn {
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;
}

.btn-success {
    background: #10b981;
    color: white;
}

.btn-success:hover {
    background: #059669;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
}

.btn-secondary {
    background: #94a3b8;
    color: white;
    text-decoration: none;
}

.btn-secondary:hover {
    background: #64748b;
}

.field-hint {
    font-size: 12px;
    color: #64748b;
    margin-top: 4px;
}

.alert {
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
}

.alert-info {
    background: #dbeafe;
    color: #0c4a6e;
    border-left: 4px solid #3b82f6;
}

@media (max-width: 768px) {
    .task-details-grid {
        grid-template-columns: 1fr;
    }

    .task-meta-info {
        grid-template-columns: 1fr;
    }

    .button-group {
        flex-direction: column;
    }

    .btn {
        width: 100%;
    }
}
</style>

<div class="task-container">
    <!-- En-tête de la tâche -->
    <div class="task-header-banner">
        <div class="task-title-main">✅ Terminer la tâche</div>
        <div class="task-meta-info">
            <div class="meta-badge">
                <span class="meta-label">📋 Titre</span>
                <span class="meta-value">{{ task.title }}</span>
            </div>
            <div class="meta-badge">
                <span class="meta-label">🎫 Ticket</span>
                <span class="meta-value">#{{ task.ticket.id }}</span>
            </div>
            <div class="meta-badge">
                <span class="meta-label">⏱️ Étape</span>
                <span class="meta-value">{{ task.stepCode|upper|replace({'_': ' '}) }}</span>
            </div>
        </div>
    </div>

    <!-- Détails de la tâche et du ticket -->
    <div class="task-details-grid">
        <!-- Détails de la tâche -->
        <div class="task-section">
            <div class="section-title">
                <span>📝</span> Détails de la tâche
            </div>
            <div class="info-row">
                <span class="info-label">Status</span>
                <span class="info-value">{{ task.status|upper }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Service</span>
                <span class="info-value">{{ task.serviceName ?: 'N/A' }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Assigné à</span>
                <span class="info-value">{{ task.assignedTo.fullName ?? task.assignedTo.email }}</span>
            </div>
            {% if task.startedAt %}
            <div class="info-row">
                <span class="info-label">Démarée le</span>
                <span class="info-value">{{ task.startedAt|date('d/m/Y H:i') }}</span>
            </div>
            {% endif %}
        </div>

        <!-- Détails du ticket -->
        <div class="task-section">
            <div class="section-title">
                <span>🎯</span> Infos du ticket
            </div>
            <div class="info-row">
                <span class="info-label">Titre</span>
                <span class="info-value">{{ task.ticket.title }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Progression</span>
                <span class="info-value">{{ task.ticket.progress }}%</span>
            </div>
            <div class="info-row">
                <span class="info-label">Sites</span>
                <span class="info-value">{{ task.ticket.ticketSites|length }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Créé le</span>
                <span class="info-value">{{ task.ticket.createdAt|date('d/m/Y') }}</span>
            </div>
        </div>
    </div>

    <!-- Description de la tâche -->
    {% if task.description %}
    <div class="task-section" style="margin-bottom: 30px;">
        <div class="section-title">
            <span>📄</span> Description
        </div>
        <p style="color: #475569; line-height: 1.6;">{{ task.description }}</p>
    </div>
    {% endif %}

    <!-- Formulaire de validation -->
    <div class="form-section">
        <div class="section-title" style="color: #1e293b;">
            <span>✏️</span> Valider la tâche
        </div>

        <div class="alert alert-info">
            <strong>💡 Info:</strong> Remplissez ce formulaire pour marquer la tâche comme complétée. 
            Un utilisateur sera automatiquement assigné à l'étape suivante et notifié.
        </div>

        {{ form_start(form, {'attr': {'class': 'workflow-form'}}) }}

            {{ form_row(form.decision, {
                'label_attr': {'class': 'form-label'},
                'attr': {'class': 'form-control'}
            }) }}

            {% if form.siteValidated is defined %}
            <div class="form-group">
                {{ form_label(form.siteValidated, 'Site validé', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.siteValidated) }}
                <div class="field-hint">Sélectionnez le site pour lequel cette validation s'applique</div>
            </div>
            {% endif %}

            <div class="form-group">
                {{ form_label(form.comment, 'Commentaire / Résultat', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.comment, {'attr': {'class': 'form-control'}}) }}
                <div class="field-hint">Décrivez l'action réalisée, les résultats, les blocages éventuels, etc.</div>
            </div>

            <div class="form-group">
                {{ form_label(form.proofFile, 'Pièce jointe / Preuve', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.proofFile, {'attr': {'class': 'form-control'}}) }}
                <div class="field-hint">Joignez une preuve (PDF, image, document) si nécessaire (max 8MB)</div>
            </div>

        {{ form_end(form) }}

        <div class="button-group">
            <a href="{{ path('team_workflow_index') }}" class="btn btn-secondary">← Annuler</a>
            <button type="submit" form="{{ form.vars.name }}" class="btn btn-success">✓ Valider et continuer</button>
        </div>
    </div>
</div>

{% endblock %}
