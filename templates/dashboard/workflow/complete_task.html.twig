{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
    .task-container {
        max-width: 900px;
        margin: 0 auto;
    }

    /* ===== HEADER SIMPLIFIÉ (pas de box noir) ===== */
    .task-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.8rem;
        border-bottom: 2px solid #e9edf4;
    }
    .task-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }
    .task-header .subtitle {
        font-size: 0.85rem;
        color: #64748b;
        margin-top: 0.2rem;
    }
    .task-header .step-badge {
        background: #e9edf4;
        padding: 0.2rem 0.8rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 600;
        color: #475569;
        display: inline-block;
    }

    /* ===== BOUTON RETOUR ROSE ===== */
    .btn-back-rose {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #ec4899;
        color: #fff;
        padding: 0.5rem 1.2rem;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.85rem;
        border: none;
        text-decoration: none;
        transition: background 0.2s, transform 0.1s;
        box-shadow: 0 4px 10px rgba(236, 72, 153, 0.25);
        flex-shrink: 0;
    }
    .btn-back-rose:hover {
        background: #db2777;
        color: #fff;
        text-decoration: none;
        transform: translateY(-1px);
    }

    /* ===== CARTE ===== */
    .task-card {
        background: #fff;
        border: 1px solid #e9edf4;
        border-radius: 0.75rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }
    .task-card .section-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }
    @media (max-width: 640px) {
        .grid-2 {
            grid-template-columns: 1fr;
        }
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 0.6rem 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
    }
    .info-row:last-child {
        border-bottom: none;
    }
    .info-label {
        color: #64748b;
        font-weight: 500;
    }
    .info-value {
        color: #0f172a;
        font-weight: 600;
    }

    /* ===== FORMULAIRE ===== */
    .form-group {
        margin-bottom: 1.2rem;
    }
    .form-label {
        display: block;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 0.4rem;
        font-size: 0.85rem;
    }
    .form-control,
    select,
    textarea {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border: 1px solid #d1d5db;
        border-radius: 0.4rem;
        font-size: 0.9rem;
        font-family: inherit;
        background: #fff;
        transition: border-color 0.15s;
    }
    .form-control:focus,
    select:focus,
    textarea:focus {
        outline: none;
        border-color: #2e75b6;
        box-shadow: 0 0 0 3px rgba(46,117,182,0.1);
    }
    textarea {
        resize: vertical;
        min-height: 100px;
    }

    .form-row-radio {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        padding-top: 0.3rem;
    }
    .form-row-radio label {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.9rem;
        cursor: pointer;
    }

    /* ===== BOUTONS ===== */
    .button-group {
        display: flex;
        gap: 0.8rem;
        justify-content: flex-end;
        margin-top: 1.5rem;
        flex-wrap: wrap;
    }
    .btn {
        padding: 0.6rem 1.5rem;
        border-radius: 0.4rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.15s;
        text-decoration: none;
        display: inline-block;
    }
    .btn-success {
        background: #16a34a;
        color: #fff;
    }
    .btn-success:hover {
        background: #15803d;
    }
    .btn-secondary {
        background: #94a3b8;
        color: #fff;
    }
    .btn-secondary:hover {
        background: #64748b;
        color: #fff;
        text-decoration: none;
    }

    /* ===== ALERT ===== */
    .alert-info {
        background: #f0f4ff;
        border-left: 4px solid #2e75b6;
        padding: 0.8rem 1rem;
        border-radius: 0.4rem;
        color: #1e293b;
        font-size: 0.9rem;
        margin-bottom: 1.2rem;
    }

    /* ===== BADGES ===== */
    .badge-status {
        display: inline-block;
        padding: 0.15rem 0.6rem;
        border-radius: 9999px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: capitalize;
    }
    .badge-done { background: #d1fae5; color: #065f46; }
    .badge-in_progress { background: #fef3c7; color: #92400e; }
    .badge-pending { background: #dbeafe; color: #1e40af; }
    .badge-open { background: #dbeafe; color: #1e40af; }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
        .task-header {
            flex-direction: column;
            align-items: flex-start;
        }
        .grid-2 {
            grid-template-columns: 1fr;
        }
        .button-group {
            flex-direction: column;
        }
        .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="task-container">

    {# ===== HEADER SIMPLIFIÉ (pas de box noir) ===== #}
    <div class="task-header">
        <div>
            <h1>Terminer la tâche</h1>
            <div class="subtitle">
                Ticket · {{ task.ticket.title }}
                <span class="step-badge">{{ task.stepCode|replace({'_': ' '})|capitalize }}</span>
            </div>
        </div>
        <a href="{{ path('user_tasks_dashboard') }}" class="btn-back-rose">← Retour</a>
    </div>

    {# ===== INFORMATIONS TÂCHE ===== #}
    <div class="task-card">
        <div class="section-title">📋 Informations de la tâche</div>
        <div class="grid-2">
            <div>
                <div class="info-row">
                    <span class="info-label">Tâche</span>
                    <span class="info-value">{{ task.title }}</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Assigné à</span>
                    <span class="info-value">{{ task.assignedTo.fullName ?? task.assignedTo.email }}</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Démarrée le</span>
                    <span class="info-value">{{ task.startedAt ? task.startedAt|date('d/m/Y H:i') : '-' }}</span>
                </div>
            </div>
            <div>
                <div class="info-row">
                    <span class="info-label">Ticket</span>
                    <span class="info-value">#{{ task.ticket.id }} — {{ task.ticket.title }}</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Statut</span>
                    <span class="info-value">
                        <span class="badge-status 
                            {% if task.status == 'done' or task.status == 'completed' %}badge-done
                            {% elseif task.status == 'in_progress' %}badge-in_progress
                            {% else %}badge-pending{% endif %}">
                            {{ task.status|replace({'_': ' '})|capitalize }}
                        </span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Date limite</span>
                    <span class="info-value">{{ task.ticket.deadline ? task.ticket.deadline|date('d/m/Y') : 'Non définie' }}</span>
                </div>
            </div>
        </div>
    </div>

    {# ===== ALERTE INFO ===== #}
    <div class="alert-info">
        <i class="fas fa-info-circle"></i>
        Une fois validée, la tâche sera transmise à l’étape suivante.
    </div>

    {# ===== FORMULAIRE ===== #}
    <div class="task-card">
        <div class="section-title">⚙️ Validation</div>
        {{ form_start(form, {'attr': {'class': 'workflow-form'}}) }}

            {# Décision #}
            {% if form.decision is defined %}
                <div class="form-group">
                    {{ form_label(form.decision) }}
                    {{ form_widget(form.decision, {'attr': {'class': 'form-control'}}) }}
                </div>
            {% endif %}

            {# Site validé #}
            {% if form.siteValidated is defined %}
                <div class="form-group">
                    {{ form_label(form.siteValidated) }}
                    {{ form_widget(form.siteValidated, {'attr': {'class': 'form-control'}}) }}
                </div>
            {% endif %}

            {# Commentaire #}
            {% if form.comment is defined %}
                <div class="form-group">
                    {{ form_label(form.comment) }}
                    {{ form_widget(form.comment, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                </div>
            {% endif %}

            {# Preuve #}
            {% if form.proofFile is defined %}
                <div class="form-group">
                    {{ form_label(form.proofFile) }}
                    {{ form_widget(form.proofFile, {'attr': {'class': 'form-control'}}) }}
                </div>
            {% endif %}

            {# Autres champs #}
            {{ form_rest(form) }}

            <div class="button-group">
                <a href="{{ path('user_tasks_dashboard') }}" class="btn btn-secondary">Annuler</a>
                <button type="submit" class="btn btn-success">✅ Valider</button>
            </div>

        {{ form_end(form) }}
    </div>

</div>
{% endblock %}