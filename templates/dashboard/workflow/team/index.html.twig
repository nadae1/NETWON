{% extends 'dashboard/base_dashboard.html.twig' %}

{% block dashboard_content %}
<style>
.workflow-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 40px;
    border-radius: 12px;
    margin-bottom: 40px;
}

.workflow-header h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
}

.workflow-header p {
    margin: 10px 0 0 0;
    opacity: 0.95;
    font-size: 16px;
}

.stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.stat-card {
    background: rgba(255, 255, 255, 0.15);
    padding: 15px;
    border-radius: 8px;
    text-align: center;
}

.stat-number {
    font-size: 28px;
    font-weight: 700;
    display: block;
}

.stat-label {
    font-size: 12px;
    opacity: 0.9;
    margin-top: 5px;
}

.tasks-section {
    margin-bottom: 50px;
}

.section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 2px solid #e2e8f0;
}

.section-title {
    font-size: 24px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
}

.section-count {
    background: #3b82f6;
    color: white;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
}

.tasks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 20px;
}

.task-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
}

.task-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
}

.task-card-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.task-status-badge {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.25);
}

.task-body {
    padding: 20px;
    flex-grow: 1;
}

.task-title {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 8px 0;
}

.task-desc {
    font-size: 13px;
    color: #64748b;
    line-height: 1.5;
    margin-bottom: 16px;
}

.task-meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    font-size: 12px;
    margin-bottom: 16px;
}

.meta-item {
    display: flex;
    gap: 6px;
    align-items: center;
    color: #475569;
}

.meta-icon {
    font-size: 14px;
}

.task-actions {
    display: flex;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid #e2e8f0;
}

.btn-action {
    flex: 1;
    padding: 10px;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 12px;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.btn-treat {
    background: #3b82f6;
    color: white;
}

.btn-treat:hover {
    background: #2563eb;
}

.btn-view {
    background: #f3f4f6;
    color: #1f2937;
}

.btn-view:hover {
    background: #e5e7eb;
}

.empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #f8fafc;
    border-radius: 12px;
    border: 2px dashed #cbd5e1;
    color: #64748b;
}

.empty-state-icon {
    font-size: 48px;
    margin-bottom: 16px;
}

.empty-state-title {
    font-size: 18px;
    font-weight: 600;
    color: #475569;
    margin-bottom: 8px;
}

.table-responsive {
    overflow-x: auto;
}

.workflow-table {
    width: 100%;
    border-collapse: collapse;
}

.workflow-table thead tr {
    background: #f8fafc;
    border-bottom: 2px solid #e2e8f0;
}

.workflow-table th {
    padding: 12px;
    text-align: left;
    font-weight: 600;
    font-size: 13px;
    color: #475569;
}

.workflow-table td {
    padding: 12px;
    border-bottom: 1px solid #e2e8f0;
    font-size: 13px;
}

.workflow-table tr:hover {
    background: #f8fafc;
}

.blocker-badge {
    display: inline-block;
    background: #fee2e2;
    color: #dc2626;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
}

@media (max-width: 768px) {
    .workflow-header {
        padding: 24px;
    }

    .workflow-header h2 {
        font-size: 24px;
    }

    .tasks-grid {
        grid-template-columns: 1fr;
    }

    .task-meta {
        grid-template-columns: 1fr;
    }

    .task-actions {
        flex-direction: column;
    }
}
</style>

<div class="team-workflow">
    <!-- En-tête du dashboard -->
    <div class="workflow-header">
        <h2>📋 Mes tâches</h2>
        <p>Tickets assignés à votre service ({{ serviceName }})</p>
        <div class="stats-row">
            <div class="stat-card">
                <span class="stat-number">{{ tasks|length }}</span>
                <span class="stat-label">En attente</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">{{ doneTasks|length }}</span>
                <span class="stat-label">Complétées</span>
            </div>
        </div>
    </div>

    <!-- Tâches actives -->
    <div class="tasks-section">
        <div class="section-header">
            <h3 class="section-title">🎯 Tâches en attente</h3>
            <span class="section-count">{{ tasks|length }}</span>
        </div>

        {% if tasks is empty %}
            <div class="empty-state">
                <div class="empty-state-icon">✅</div>
                <div class="empty-state-title">Aucune tâche en attente</div>
                <p>Vous n'avez pas de tâche à traiter pour le moment. Bon travail !</p>
            </div>
        {% else %}
            <div class="tasks-grid">
                {% for task in tasks %}
                    <div class="task-card">
                        <div class="task-card-header">
                            <h4 class="task-title" style="color: white; margin: 0;">{{ task.title }}</h4>
                            <span class="task-status-badge">{{ task.status|upper }}</span>
                        </div>
                        
                        <div class="task-body">
                            <p class="task-desc">
                                {{ task.description|slice(0, 100) }}{% if task.description|length > 100 %}...{% endif %}
                            </p>
                            
                            <div class="task-meta">
                                <div class="meta-item">
                                    <span class="meta-icon">🎫</span>
                                    <a href="{{ path('dashboard_workflow_show', {id: task.ticket.id}) }}" style="color: #3b82f6; text-decoration: none;">
                                        Ticket #{{ task.ticket.id }}
                                    </a>
                                </div>
                                <div class="meta-item">
                                    <span class="meta-icon">📍</span>
                                    <span>{{ task.ticket.ticketSites|length }} site(s)</span>
                                </div>
                                {% if task.ticket.deadlineAt %}
                                <div class="meta-item" style="{% if task.ticket.deadlineAt < date() %}color: #dc2626;{% endif %}">
                                    <span class="meta-icon">⏰</span>
                                    <span>{{ task.ticket.deadlineAt|date('d/m/Y') }}</span>
                                </div>
                                {% endif %}
                                <div class="meta-item">
                                    <span class="meta-icon">👤</span>
                                    <span>{{ task.ticket.createdBy.fullName ?? task.ticket.createdBy.email|slice(0, 15) }}</span>
                                </div>
                            </div>

                            {% if task.ticketBlockedInfo and task.ticketBlockedInfo.user and task.ticketBlockedInfo.user.id == app.user.id %}
                                <div style="margin-bottom: 12px; padding: 8px; background: #fee2e2; border-radius: 6px; color: #dc2626; font-size: 12px;">
                                    🚫 <strong>Bloquée chez vous !</strong> Veuillez résoudre cette étape pour continuer.
                                </div>
                            {% endif %}
                            
                            <div class="task-actions">
                                <a href="{{ path('team_workflow_task_show', {id: task.id}) }}" class="btn-action btn-treat">
                                    ✓ Traiter
                                </a>
                                <a href="{{ path('dashboard_workflow_show', {id: task.ticket.id}) }}" class="btn-action btn-view">
                                    👁️ Voir
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <!-- Tâches terminées récentes -->
    {% if doneTasks is not empty %}
    <div class="tasks-section">
        <div class="section-header">
            <h3 class="section-title">✅ Tâches complétées</h3>
            <span class="section-count">{{ doneTasks|length }}</span>
        </div>

        <div class="table-responsive">
            <table class="workflow-table">
                <thead>
                    <tr>
                        <th>📝 Titre</th>
                        <th>🎫 Ticket</th>
                        <th>✓ Complétée le</th>
                        <th>🎯 Décision</th>
                    </tr>
                </thead>
                <tbody>
                    {% for task in doneTasks|slice(0, 15) %}
                        <tr>
                            <td>
                                <a href="{{ path('dashboard_workflow_show', {id: task.ticket.id}) }}" style="color: #3b82f6; text-decoration: none;">
                                    {{ task.title|slice(0, 50) }}
                                </a>
                            </td>
                            <td>
                                <a href="{{ path('dashboard_workflow_show', {id: task.ticket.id}) }}" style="color: #3b82f6; text-decoration: none;">
                                    #{{ task.ticket.id }}
                                </a>
                            </td>
                            <td>{{ task.completedAt ? task.completedAt|date('d/m/Y H:i') : '-' }}</td>
                            <td>
                                {% if task.decision %}
                                    <span class="blocker-badge" style="background: #dcfce7; color: #16a34a;">
                                        {{ task.decision|upper }}
                                    </span>
                                {% else %}
                                    <span style="color: #94a3b8;">-</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}
</div>

<script>
    // Auto-refresh de la page toutes les 30 secondes pour les mises à jour en temps réel
    setTimeout(() => {
        location.reload();
    }, 30000);
</script>
{% endblock %}