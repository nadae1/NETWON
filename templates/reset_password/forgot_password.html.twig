
{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div style="max-width:420px;margin:60px auto;padding:30px;background:#fff;border-radius:20px;box-shadow:0 10px 25px rgba(0,0,0,.08);">
    <h2 style="margin-top:0;">Réinitialiser le mot de passe</h2>

    {% for message in app.flashes('error') %}
        <div style="background:#fdecec;color:#b42318;padding:10px;border-radius:10px;margin-bottom:10px;">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <div style="background:#ecfdf3;color:#027a48;padding:10px;border-radius:10px;margin-bottom:10px;">{{ message }}</div>
    {% endfor %}

    <form method="post">
        <div style="margin-bottom:14px;">
            <label>Username</label>
            <input type="text" name="username" required style="width:100%;height:44px;padding:0 12px;border:1px solid #d0d5dd;border-radius:12px;">
        </div>

        <div style="margin-bottom:14px;">
            <label>Email</label>
            <input type="email" name="email" required style="width:100%;height:44px;padding:0 12px;border:1px solid #d0d5dd;border-radius:12px;">
        </div>

        <button type="submit" style="width:100%;height:46px;border:none;border-radius:12px;background:#ff7900;color:#fff;">Envoyer le code</button>
    </form>
</div>
{% endblock %}