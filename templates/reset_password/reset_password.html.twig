{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
<div style="max-width:420px;margin:60px auto;padding:30px;background:#fff;border-radius:20px;box-shadow:0 10px 25px rgba(0,0,0,.08);">
    <h2 style="margin-top:0;">Nouveau mot de passe</h2>

    {% for message in app.flashes('error') %}
        <div style="background:#fdecec;color:#b42318;padding:10px;border-radius:10px;margin-bottom:10px;">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <div style="background:#ecfdf3;color:#027a48;padding:10px;border-radius:10px;margin-bottom:10px;">{{ message }}</div>
    {% endfor %}

    <form method="post">
        <div style="margin-bottom:14px;">
            <label>Nouveau mot de passe</label>
            <input type="password" name="password" required style="width:100%;height:44px;padding:0 12px;border:1px solid #d0d5dd;border-radius:12px;">
        </div>

        <div style="margin-bottom:14px;">
            <label>Confirmer le mot de passe</label>
            <input type="password" name="confirm_password" required style="width:100%;height:44px;padding:0 12px;border:1px solid #d0d5dd;border-radius:12px;">
        </div>

        <button type="submit" style="width:100%;height:46px;border:none;border-radius:12px;background:#ff7900;color:#fff;">Valider</button>
    </form>
</div>
{% endblock %}